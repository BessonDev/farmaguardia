---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EmptyState from '../components/EmptyState.astro';

const pathname = Astro.url.pathname;
---

<Layout
  title="Página no encontrada - FarmaGuardia"
  description="La página que buscas no existe. Vuelve al inicio para consultar qué farmacia está de turno en Puerto Ayacucho."
  noindex
>
  <Header />

  <main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <EmptyState
      icon="search"
      iconTone="primary"
      headingLevel={2}
      title="No encontramos esta página"
      description="Puede que el enlace esté roto o que la dirección haya cambiado. Verifica la URL o vuelve al inicio."
      actionHref="/"
      actionLabel="Volver al inicio"
      secondaryActionHref="/#faq-title"
      secondaryActionLabel="Preguntas frecuentes"
    >
      <p class="mt-4 inline-flex max-w-full items-center gap-2 rounded-lg bg-gray-100 px-3 py-1.5 font-mono text-xs break-all text-gray-600 dark:bg-gray-800 dark:text-gray-400">
        <span aria-hidden="true" class="text-gray-400 dark:text-gray-500">→</span>
        <span>{pathname}</span>
      </p>
    </EmptyState>
  </main>
</Layout>
