---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EmptyState from '../components/EmptyState.astro';

interface Props {
  error: unknown;
}

const { error } = Astro.props;
const pathname = Astro.url.pathname;
const detalle = import.meta.env.DEV && error instanceof Error ? error.message : null;
---

<Layout
  title="Error del servidor - FarmaGuardia"
  description="Ocurrió un error inesperado en FarmaGuardia. Intenta recargar la página o vuelve al inicio."
  noindex
>
  <Header />

  <main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <EmptyState
      icon="alert"
      iconTone="warning"
      headingLevel={2}
      title="Algo salió mal de nuestro lado"
      description="Es un fallo nuestro, no tuyo. Intenta recargar la página; si el problema continúa, vuelve al inicio."
      actionHref={pathname}
      actionLabel="Reintentar"
      secondaryActionHref="/"
      secondaryActionLabel="Volver al inicio"
    >
      <p class="mt-4 inline-flex max-w-full items-center gap-2 rounded-lg bg-gray-100 px-3 py-1.5 font-mono text-xs break-all text-gray-600 dark:bg-gray-800 dark:text-gray-400">
        <span aria-hidden="true" class="text-gray-400 dark:text-gray-500">→</span>
        <span>{pathname}</span>
      </p>

      {detalle && (
        <p class="mt-3 max-w-md mx-auto rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-left font-mono text-xs break-all text-amber-800 dark:border-amber-900 dark:bg-amber-950/50 dark:text-amber-300" role="alert">
          {detalle}
        </p>
      )}
    </EmptyState>
  </main>
</Layout>
