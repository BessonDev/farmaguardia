---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CardTurnoActual from '../components/CardTurnoActual.astro';
import ListaProximosTurnos from '../components/ListaProximosTurnos.astro';
import { db } from '../db';
import { farmacias, turnos, reportes } from '../db/schema';
import { eq, and, gte, lte, gt, inArray } from 'drizzle-orm';
import { toUtcISO, nowUtc, formatCaracasDateTime } from '../utils/time';

export const prerender = false;

const ahora = nowUtc();
const ahoraISO = toUtcISO(ahora);

// Query turnos activos: inicio <= ahora < fin (estricto en fin para evitar doble a las 08:00)
const turnosActivos = await db
  .select({
    id: turnos.id,
    farmaciaId: turnos.farmaciaId,
    inicio: turnos.inicio,
    fin: turnos.fin,
    notas: turnos.notas,
    farmacia: {
      id: farmacias.id,
      nombre: farmacias.nombre,
      direccion: farmacias.direccion,
      telefono: farmacias.telefono,
      whatsapp: farmacias.whatsapp,
      latitud: farmacias.latitud,
      longitud: farmacias.longitud,
      imagenUrl: farmacias.imagenUrl,
      sector: farmacias.sector,
      delivery: farmacias.delivery,
    },
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(and(
    lte(turnos.inicio, ahoraISO),
    gt(turnos.fin, ahoraISO),
    eq(farmacias.activa, 1)
  ))
  .orderBy(turnos.inicio);

// Reportes de los turnos activos (para badge de confirmación)
const turnosActivosIds = turnosActivos.map(t => t.id);
const reportesActivos = turnosActivosIds.length > 0
  ? await db
      .select({
        id: reportes.id,
        turnoId: reportes.turnoId,
        tipo: reportes.tipo,
        detalle: reportes.detalle,
        confirmaciones: reportes.confirmaciones,
        createdAt: reportes.createdAt,
      })
      .from(reportes)
      .where(inArray(reportes.turnoId, turnosActivosIds))
      .orderBy(reportes.confirmaciones)
  : [];
const reportesPorTurno = new Map<number, typeof reportesActivos[number]>();
for (const r of reportesActivos) {
  if (r.turnoId !== null && !reportesPorTurno.has(r.turnoId)) {
    reportesPorTurno.set(r.turnoId, r);
  }
}
const finSemana = new Date(ahora);
finSemana.setUTCDate(finSemana.getUTCDate() + 7);
finSemana.setUTCHours(23, 59, 59, 999);
const finSemanaISO = toUtcISO(finSemana);

const proximosTurnosResult = await db
  .select({
    id: turnos.id,
    farmaciaId: turnos.farmaciaId,
    inicio: turnos.inicio,
    fin: turnos.fin,
    notas: turnos.notas,
    farmacia: {
      id: farmacias.id,
      nombre: farmacias.nombre,
      direccion: farmacias.direccion,
      telefono: farmacias.telefono,
      whatsapp: farmacias.whatsapp,
      latitud: farmacias.latitud,
      longitud: farmacias.longitud,
      imagenUrl: farmacias.imagenUrl,
      sector: farmacias.sector,
      delivery: farmacias.delivery,
    },
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(and(
    gte(turnos.inicio, ahoraISO),
    lte(turnos.inicio, finSemanaISO),
    eq(farmacias.activa, 1)
  ))
  .orderBy(turnos.inicio)
  .limit(14);

const proximosTurnos = proximosTurnosResult;

// Números de emergencia locales
const EMERGENCIAS = [
  { nombre: 'Protección Civil Amazonas', telefono: '0248-5210171' },
  { nombre: 'Bomberos Puerto Ayacucho', telefono: '0248-5210171' },
  { nombre: 'CDI Dr. Gilberto Rodríguez Ochoa', telefono: '0248-5210171' },
];
---

<Layout title="FarmaGuardia - Farmacias de Turno en Puerto Ayacucho" description="Consulta en tiempo real qué farmacia está de turno 24h en Puerto Ayacucho, Estado Amazonas. Contacto directo y ubicación.">
  <Header />

  <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-10">
    {turnosActivos.length > 0 ? (
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Farmacias de turno ahora
          </h2>
          <span class="inline-flex items-center gap-1.5 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 text-xs font-medium px-3 py-1 rounded-full">
            <span class="relative flex w-2 h-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full w-2 h-2 bg-emerald-500"></span>
            </span>
            {turnosActivos.length} {turnosActivos.length === 1 ? 'abierta' : 'abiertas'}
          </span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
          {turnosActivos.map(turno => (
            <CardTurnoActual
              farmacia={turno.farmacia}
              turnoId={turno.id}
              finTurno={turno.fin}
              isCurrent={true}
              reporte={reportesPorTurno.get(turno.id)}
            />
          ))}
        </div>
      </section>
    ) : (
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm p-8 sm:p-10 text-center">
        <svg class="w-16 h-16 mx-auto text-gray-300 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">No hay turno activo en este momento</h2>
        <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-md mx-auto">
          No tenemos registrada niguna farmacia de turno en este momento
        </p>
        <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-5 text-left max-w-md mx-auto">
          <h3 class="font-medium text-amber-800 dark:text-amber-200 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Números de emergencia en Puerto Ayacucho
          </h3>
          <ul class="space-y-2 text-sm text-amber-700 dark:text-amber-300">
            {EMERGENCIAS.map(e => (
              <li class="flex justify-between items-center gap-3">
                <span>{e.nombre}</span>
                <a href={`tel:+58${e.telefono.replace(/\D/g, '')}`} class="font-mono underline hover:text-amber-600 dark:hover:text-amber-400 shrink-0">
                  {e.telefono}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    <ListaProximosTurnos turnos={proximosTurnos} />
  </main>
</Layout>