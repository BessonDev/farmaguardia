---
import LayoutAdmin from '~/layouts/LayoutAdmin.astro';
import { db, schema } from '~/db/client';
import { eq } from 'drizzle-orm';
import { cookies, makeCsrfToken } from '~/lib/auth';

const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');

const csrfToken = makeCsrfToken();
Astro.cookies.set(cookies.csrf, csrfToken, {
  path: '/',
  httpOnly: false,
  sameSite: 'lax',
  maxAge: 86400,
});

const user = db.select().from(schema.usuarios).where(eq(schema.usuarios.username, 'admin')).get();
const username = user?.username ?? 'admin';
---

<LayoutAdmin title="Cambiar contraseña">
  <h2>Cambiar contraseña</h2>

  {error === 'invalid' && (
    <div class="card" style="border-color: rgba(239,68,68,0.3); background: rgba(239,68,68,0.05);">
      <p style="margin:0; color:#fca5a5; font-size:14px;">La contraseña actual no es correcta.</p>
    </div>
  )}
  {error === 'mismatch' && (
    <div class="card" style="border-color: rgba(239,68,68,0.3); background: rgba(239,68,68,0.05);">
      <p style="margin:0; color:#fca5a5; font-size:14px;">La nueva contraseña y la confirmación no coinciden.</p>
    </div>
  )}
  {error === 'short' && (
    <div class="card" style="border-color: rgba(239,68,68,0.3); background: rgba(239,68,68,0.05);">
      <p style="margin:0; color:#fca5a5; font-size:14px;">La nueva contraseña debe tener al menos 8 caracteres.</p>
    </div>
  )}
  {ok === '1' && (
    <div class="card" style="border-color: rgba(34,197,94,0.3); background: rgba(34,197,94,0.05);">
      <p style="margin:0; color:#22c55e; font-size:14px;">Contraseña actualizada correctamente.</p>
    </div>
  )}

  <div class="card">
    <form method="post" action="/admin/api/cambiar-password">
      <input type="hidden" name="_csrf" value={csrfToken} />

      <label class="field">
        <span>Nombre de usuario</span>
        <input type="text" value={username} disabled style="opacity:0.6;" />
      </label>

      <label class="field">
        <span>Contraseña actual</span>
        <input type="password" name="password_actual" required autocomplete="current-password" />
      </label>

      <label class="field">
        <span>Nueva contraseña</span>
        <input type="password" name="password_nueva" required autocomplete="new-password" minlength={8} />
      </label>

      <label class="field">
        <span>Confirmar nueva contraseña</span>
        <input type="password" name="password_confirmar" required autocomplete="new-password" minlength={8} />
      </label>

      <button type="submit" class="primary" style="margin-top:8px;">Guardar cambios</button>
    </form>
  </div>
</LayoutAdmin>
