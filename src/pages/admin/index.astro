---
import Layout from '../../layouts/Layout.astro';
import { actions } from 'astro:actions';
import { db } from '../../db';
import { farmacias, turnos, reportes } from '../../db/schema';
import { eq, and, gte, lte, sql } from 'drizzle-orm';
import { toUtcISO, nowUtc, formatCaracasDateTime } from '../../utils/time';

const ahoraISO = toUtcISO(nowUtc());

// Turno actual
const turnoActual = (await db
  .select({
    id: turnos.id,
    inicio: turnos.inicio,
    fin: turnos.fin,
    nombre: farmacias.nombre,
    sector: farmacias.sector,
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(and(lte(turnos.inicio, ahoraISO), gte(turnos.fin, ahoraISO)))
  .limit(1))[0] || null;

// Próximos turnos (7 días)
const dentroDe7Dias = new Date();
dentroDe7Dias.setUTCDate(dentroDe7Dias.getUTCDate() + 7);

const proximos = await db
  .select({
    id: turnos.id,
    inicio: turnos.inicio,
    fin: turnos.fin,
    nombre: farmacias.nombre,
    sector: farmacias.sector,
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(gte(turnos.inicio, ahoraISO))
  .orderBy(turnos.inicio)
  .limit(7);

// Estadísticas
const totalFarmacias = (await db.select({ count: sql`count(*)` }).from(farmacias))[0].count;
const totalTurnos = (await db.select({ count: sql`count(*)` }).from(turnos))[0].count;
const totalReportes = (await db.select({ count: sql`count(*)` }).from(reportes))[0].count;

const farmaciasActivas = await db.select().from(farmacias).where(eq(farmacias.activa, 1));
---

<Layout title="Dashboard - FarmaGuardia Admin">
  <div class="min-h-full flex">
    <!-- Sidebar -->
    <aside class="hidden md:flex flex-col w-56 border-r border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50 shrink-0">
      <div class="p-4 border-b border-gray-200 dark:border-gray-800">
        <div class="flex items-center gap-2">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="font-bold text-gray-900 dark:text-gray-100">FarmaGuardia</span>
        </div>
        <p class="text-xs text-gray-500 mt-1">Panel de Administración</p>
      </div>
      <nav class="flex-1 p-3 space-y-1">
        <a href="/admin" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-primary text-white font-medium text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10" />
          </svg>
          Dashboard
        </a>
        <a href="/admin/farmacias" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          Farmacias
        </a>
        <a href="/admin/turnos" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Turnos
        </a>
        <a href="/" target="_blank" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Ver landing
        </a>
      </nav>
      <div class="p-3 border-t border-gray-200 dark:border-gray-800">
        <form method="POST" action={actions.logout}>
          <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Topbar (móvil) -->
      <div class="md:hidden flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800">
        <span class="font-bold text-gray-900 dark:text-gray-100">FarmaGuardia Admin</span>
        <div class="flex gap-2">
          <a href="/admin/farmacias" class="text-sm text-primary">Farmacias</a>
          <a href="/admin/turnos" class="text-sm text-primary">Turnos</a>
          <a href="/" class="text-sm text-primary">Landing</a>
        </div>
      </div>

      <main class="flex-1 p-4 sm:p-6 overflow-x-clip">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Dashboard</h1>

        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
            <p class="text-sm text-gray-500 dark:text-gray-400">Farmacias activas</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">{farmaciasActivas.length} / {Number(totalFarmacias)}</p>
          </div>
          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
            <p class="text-sm text-gray-500 dark:text-gray-400">Turnos totales</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">{Number(totalTurnos)}</p>
          </div>
          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
            <p class="text-sm text-gray-500 dark:text-gray-400">Reportes</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">{Number(totalReportes)}</p>
          </div>
        </div>

        <!-- Turno actual -->
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">Turno actual</h2>
          {turnoActual ? (
            <div class="bg-primary text-white rounded-xl p-4 sm:p-5">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div>
                  <p class="text-sm opacity-90">{turnoActual.nombre} {turnoActual.sector && `· ${turnoActual.sector}`}</p>
                  <p class="text-xs opacity-75 mt-1">
                    {formatCaracasDateTime(new Date(turnoActual.inicio))} → {formatCaracasDateTime(new Date(turnoActual.fin))}
                  </p>
                </div>
                <span class="inline-flex items-center gap-1.5 bg-white/20 px-3 py-1 rounded-full text-sm font-medium animate-pulse-slow w-fit">
                  <span class="w-2 h-2 bg-white rounded-full"></span>
                  ACTIVO
                </span>
              </div>
            </div>
          ) : (
            <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-4 text-amber-800 dark:text-amber-200">
              No hay turno activo en este momento.
            </div>
          )}
        </div>

        <!-- Próximos turnos -->
        <div class="mb-8">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Próximos turnos</h2>
            <a href="/admin/turnos" class="text-sm text-primary hover:underline">Gestionar →</a>
          </div>
          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr class="text-left text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                  <th class="px-4 py-2">Farmacia</th>
                  <th class="px-4 py-2 hidden sm:table-cell">Inicio</th>
                  <th class="px-4 py-2 hidden sm:table-cell">Fin</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
                {proximos.map(t => (
                  <tr>
                    <td class="px-4 py-2 font-medium text-gray-900 dark:text-gray-100">{t.nombre}</td>
                    <td class="px-4 py-2 text-gray-600 dark:text-gray-300 hidden sm:table-cell">{formatCaracasDateTime(new Date(t.inicio))}</td>
                    <td class="px-4 py-2 text-gray-600 dark:text-gray-300 hidden sm:table-cell">{formatCaracasDateTime(new Date(t.fin))}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>