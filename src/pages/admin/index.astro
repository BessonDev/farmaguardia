---
import LayoutAdmin from '~/layouts/LayoutAdmin.astro';
import { getTurnoActivo } from '~/lib/turno-actual';
import { formatHoraCaracas, formatFechaCortaCaracas } from '~/lib/tz';
import { db, schema } from '~/db/client';
import { count, gte } from 'drizzle-orm';

const turno = await getTurnoActivo();

const [farmaciasTotal] = db
  .select({ n: count() })
  .from(schema.farmacias)
  .all();

const [farmaciasActivas] = db
  .select({ n: count() })
  .from(schema.farmacias)
  .where(gte(schema.farmacias.activa, 1))
  .all();

const [turnosFuturos] = db
  .select({ n: count() })
  .from(schema.turnos)
  .where(gte(schema.turnos.finUtc, new Date().toISOString()))
  .all();

const [overridesVigentes] = db
  .select({ n: count() })
  .from(schema.anunciosTurno)
  .where(gte(schema.anunciosTurno.vigenteHastaUtc, new Date().toISOString()))
  .all();
---

<LayoutAdmin title="Dashboard">
  <h2>Dashboard</h2>

  <div class="row">
    <div class="stat">
      <div class="label">Farmacias totales</div>
      <div class="value">{farmaciasTotal?.n ?? 0}</div>
    </div>
    <div class="stat">
      <div class="label">Farmacias activas</div>
      <div class="value">{farmaciasActivas?.n ?? 0}</div>
    </div>
    <div class="stat">
      <div class="label">Turnos programados</div>
      <div class="value">{turnosFuturos?.n ?? 0}</div>
    </div>
    <div class="stat">
      <div class="label">Overrides vigentes</div>
      <div class="value">{overridesVigentes?.n ?? 0}</div>
    </div>
  </div>

  <div class="card">
    <h3>Turno activo ahora</h3>
    {turno ? (
      <div>
        <p style="margin: 0 0 8px; font-size: 18px; font-weight: 600;">
          {turno.farmacia.nombre}
          {turno.enOverride && <span class="badge yellow" style="margin-left: 8px;">OVERRIDE</span>}
        </p>
        <p style="margin: 0 0 4px; color: var(--fg-muted); font-size: 14px;">
          📍 {turno.farmacia.direccion}
        </p>
        <p style="margin: 0; color: var(--fg-muted); font-size: 14px;">
          ⏰ Hasta las {formatHoraCaracas(turno.finUtc)} ({formatFechaCortaCaracas(turno.finUtc)})
        </p>
        {turno.motivoOverride && (
          <p style="margin: 12px 0 0; padding: 10px; background: rgba(234, 179, 8, 0.1); border-radius: 8px; font-size: 13px;">
            ⚠️ {turno.motivoOverride}
          </p>
        )}
        <div style="margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap;">
          <a href="/admin/overrides/nuevo" class="primary" style="background: var(--danger); color: white;">
            🚨 Cambiar turno de emergencia
          </a>
          <a href={`/admin/turnos?farmacia_id=${turno.farmacia.id}`} class="secondary">
            Ver turnos de esta farmacia
          </a>
        </div>
      </div>
    ) : (
      <p style="margin: 0; color: var(--fg-muted);">
        No hay farmacia de turno registrada en este momento.
      </p>
    )}
  </div>

  <div class="card">
    <h3>Acciones rápidas</h3>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <a href="/admin/farmacias/nueva" class="primary">+ Nueva farmacia</a>
      <a href="/admin/turnos/nuevo" class="secondary">+ Nuevo turno</a>
      <a href="/admin/farmacias" class="secondary">Ver todas las farmacias</a>
    </div>
  </div>
</LayoutAdmin>