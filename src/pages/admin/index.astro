---
// src/pages/admin/index.astro
import { db } from '../../db';
import { farmacias, turnos } from '../../db/schema';
import { eq, and, lte, gte, count } from 'drizzle-orm';
import { format } from 'date-fns';

// Get statistics
const [totalFarmacias, activeFarmacias, currentTurno] = await Promise.all([
  db.select({ count: count() }).from(farmacias),
  db.select({ count: count() }).from(farmacias).where(eq(farmacias.activa, 1)),
  db
    .select({
      farmacia: farmacias,
      turno: turnos
    })
    .from(turnos)
    .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
    .where(
      and(
        lte(turnos.inicio, new Date()),
        gte(turnos.fin, new Date())
      )
    )
    .limit(1)
    .then(res => res[0] || null)
});

// Get upcoming turns (next 24 hours)
const upcomingTurnos = await db
  .select({
    farmacia: farmacias,
    turno: turnos
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(
    and(
      gte(turnos.inicio, new Date()),
      lte(turnos.inicio, new Date(Date.now() + 24 * 60 * 60 * 1000))
    )
  )
  .orderBy(turnos.inicio)
  .limit(5);
---
<layout>
  <div class="space-y-6">
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-4">
          Total Farmacias
        </h3>
        <p class="text-3xl font-bold text-indigo-600">
          {totalFarmacias[0].count}
        </p>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-4">
          Farmacias Activas
        </h3>
        <p class="text-3xl font-bold text-emerald-600">
          {activeFarmacias[0].count}
        </p>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-4">
          Turno Actual
        </h3>
        {currentTurno ? (
          <div class="space-y-2">
            <p class="font-medium text-gray-900 dark:text-gray-100">
              {currentTurno.farmacia.nombre}
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Desde {format(new Date(currentTurno.turno.inicio), 'HH:mm')} 
              hasta {format(new Date(currentTurno.turno.fin), 'HH:mm')}
            </p>
          </div>
        ) : (
          <p class="text-gray-500">No hay turno activo</p>
        )}
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-4">
          Próximos Turnos (24h)
        </h3>
        {upcomingTurnos.length > 0 ? (
          <ul class="space-y-2">
            {upcomingTurnos.map((ut, index) => (
              <li key={index} class="flex justify-between text-sm">
                <span class="font-medium">{ut.farmacia.nombre}</span>
                <span>{format(new Date(ut.turno.inicio), 'HH:mm')}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-500">No hay turnos programados</p>
        )}
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <a 
        href="/admin/farmacias" 
        class="block bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-shadow p-6"
      >
        <div class="flex flex-col items-center">
          <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
          </div>
          <h3 class="font-medium text-gray-900 dark:text-gray-100">Gestionar Farmacias</h3>
          <p class="text-sm text-gray-500 mt-1">Agregar, editar o eliminar farmacias</p>
        </div>
      </a>

      <a 
        href="/admin/turnos" 
        class="block bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-shadow p-6"
      >
        <div class="flex flex-col items-center">
          <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="font-medium text-gray-900 dark:text-gray-100">Gestionar Turnos</h3>
          <p class="text-sm text-gray-500 mt-1">Asignar horarios de turno a las farmacias</p>
        </div>
      </a>

      <a 
        href="#" 
        class="block bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-shadow p-6"
        onclick="alert('Próximamente: Reportes y estadísticas')"
      >
        <div class="flex flex-col items-center">
          <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
          <h3 class="font-medium text-gray-900 dark:text-gray-100">Reportes</h3>
          <p class="text-sm text-gray-500 mt-1">Ver estadísticas y reportes de uso</p>
        </div>
      </a>
    </div>
  </div>
</layout>