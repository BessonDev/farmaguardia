---
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import { db } from '../../db';
import { farmacias, turnos, reportes } from '../../db/schema';
import { eq, and, gte, lte, sql } from 'drizzle-orm';
import { toUtcISO, nowUtc, formatCaracasDateTime } from '../../utils/time';

const ahoraISO = toUtcISO(nowUtc());

// Turnos activos ahora
const turnosActivos = await db
  .select({
    id: turnos.id,
    inicio: turnos.inicio,
    fin: turnos.fin,
    nombre: farmacias.nombre,
    sector: farmacias.sector,
    farmaciaId: farmacias.id,
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(and(lte(turnos.inicio, ahoraISO), gt(turnos.fin, ahoraISO)))
  .orderBy(turnos.inicio);

// Próximos turnos (7 días)
const dentroDe7Dias = new Date();
dentroDe7Dias.setUTCDate(dentroDe7Dias.getUTCDate() + 7);

const proximos = await db
  .select({
    id: turnos.id,
    inicio: turnos.inicio,
    fin: turnos.fin,
    nombre: farmacias.nombre,
    sector: farmacias.sector,
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(gte(turnos.inicio, ahoraISO))
  .orderBy(turnos.inicio)
  .limit(7);

// Estadísticas
const totalFarmacias = (await db.select({ count: sql`count(*)` }).from(farmacias))[0].count;
const totalTurnos = (await db.select({ count: sql`count(*)` }).from(turnos))[0].count;
const totalReportes = (await db.select({ count: sql`count(*)` }).from(reportes))[0].count;

const farmaciasActivas = await db.select().from(farmacias).where(eq(farmacias.activa, 1));
---

<Layout title="Dashboard - FarmaGuardia Admin">
  <div class="min-h-full flex">
    <AdminSidebar active="dashboard" />

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Topbar (móvil) -->
      <div class="md:hidden flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800">
        <span class="font-bold text-gray-900 dark:text-gray-100">FarmaGuardia Admin</span>
        <div class="flex gap-2">
          <a href="/admin/farmacias" class="text-sm text-primary">Farmacias</a>
          <a href="/admin/turnos" class="text-sm text-primary">Turnos</a>
          <a href="/" class="text-sm text-primary">Landing</a>
        </div>
      </div>

      <main class="flex-1 p-4 sm:p-6 overflow-x-clip">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Dashboard</h1>

        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
            <p class="text-sm text-gray-500 dark:text-gray-400">Farmacias activas</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">{farmaciasActivas.length} / {Number(totalFarmacias)}</p>
          </div>
          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
            <p class="text-sm text-gray-500 dark:text-gray-400">Turnos totales</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">{Number(totalTurnos)}</p>
          </div>
          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
            <p class="text-sm text-gray-500 dark:text-gray-400">Reportes</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">{Number(totalReportes)}</p>
          </div>
        </div>

        <!-- Turnos activos -->
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">Turnos activos ahora ({turnosActivos.length})</h2>
          {turnosActivos.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {turnosActivos.map(t => (
                <div class="bg-primary text-white rounded-xl p-4 sm:p-5">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                    <div>
                      <p class="text-sm opacity-90">{t.nombre} {t.sector && `· ${t.sector}`}</p>
                      <p class="text-xs opacity-75 mt-1">
                        {formatCaracasDateTime(new Date(t.inicio))} → {formatCaracasDateTime(new Date(t.fin))}
                      </p>
                    </div>
                    <span class="inline-flex items-center gap-1.5 bg-white/20 px-3 py-1 rounded-full text-sm font-medium animate-pulse-slow w-fit">
                      <span class="w-2 h-2 bg-white rounded-full"></span>
                      ACTIVO
                    </span>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-4 text-amber-800 dark:text-amber-200">
              No hay turnos activos en este momento.
            </div>
          )}
        </div>

        <!-- Próximos turnos -->
        <div class="mb-8">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Próximos turnos</h2>
            <a href="/admin/turnos" class="text-sm text-primary hover:underline">Gestionar →</a>
          </div>
          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr class="text-left text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                  <th class="px-4 py-2">Farmacia</th>
                  <th class="px-4 py-2 hidden sm:table-cell">Inicio</th>
                  <th class="px-4 py-2 hidden sm:table-cell">Fin</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
                {proximos.map(t => (
                  <tr>
                    <td class="px-4 py-2 font-medium text-gray-900 dark:text-gray-100">{t.nombre}</td>
                    <td class="px-4 py-2 text-gray-600 dark:text-gray-300 hidden sm:table-cell">{formatCaracasDateTime(new Date(t.inicio))}</td>
                    <td class="px-4 py-2 text-gray-600 dark:text-gray-300 hidden sm:table-cell">{formatCaracasDateTime(new Date(t.fin))}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>