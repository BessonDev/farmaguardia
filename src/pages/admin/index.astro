---
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import { actions } from 'astro:actions';
import { db } from '../../db';
import { farmacias, turnos, reportes, visitas } from '../../db/schema';
import { eq, and, gte, lte, sql, gt } from 'drizzle-orm';
import { toUtcISO, nowUtc, formatCaracasDateTime, utcToCaracas } from '../../utils/time';

const resultTelegram = Astro.getActionResult(actions.testTelegram);

const ahoraISO = toUtcISO(nowUtc());

// Turnos activos ahora
const turnosActivos = await db
  .select({
    id: turnos.id,
    inicio: turnos.inicio,
    fin: turnos.fin,
    nombre: farmacias.nombre,
    sector: farmacias.sector,
    farmaciaId: farmacias.id,
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(and(lte(turnos.inicio, ahoraISO), gt(turnos.fin, ahoraISO)))
  .orderBy(turnos.inicio);

// Próximos turnos (7 días)
const dentroDe7Dias = new Date();
dentroDe7Dias.setUTCDate(dentroDe7Dias.getUTCDate() + 7);

const proximos = await db
  .select({
    id: turnos.id,
    inicio: turnos.inicio,
    fin: turnos.fin,
    nombre: farmacias.nombre,
    sector: farmacias.sector,
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(gte(turnos.inicio, ahoraISO))
  .orderBy(turnos.inicio)
  .limit(7);

// Estadísticas
const totalFarmacias = (await db.select({ count: sql`count(*)` }).from(farmacias))[0].count;
const totalTurnos = (await db.select({ count: sql`count(*)` }).from(turnos))[0].count;
const totalReportes = (await db.select({ count: sql`count(*)` }).from(reportes))[0].count;

const farmaciasActivas = await db.select().from(farmacias).where(eq(farmacias.activa, 1));

// ─── Analytics ───
const hace7Dias = new Date();
hace7Dias.setUTCDate(hace7Dias.getUTCDate() - 7);

// Visitas por día (últimos 7 días, hora Caracas)
const visitasPorDia = await db
  .select({
    dia: sql<string>`date(datetime(${visitas.createdAt}, '-4 hours'))`,
    total: sql<number>`count(*)`,
  })
  .from(visitas)
  .where(gte(visitas.createdAt, toUtcISO(hace7Dias)))
  .groupBy(sql`date(datetime(${visitas.createdAt}, '-4 hours'))`)
  .orderBy(sql`date(datetime(${visitas.createdAt}, '-4 hours'))`);

const totalVisitasSemana = visitasPorDia.reduce((acc, v) => acc + Number(v.total), 0);
const maxVisitasDia = Math.max(1, ...visitasPorDia.map(v => Number(v.total)));

// Horarios pico (visitas por hora Caracas, últimos 7 días)
const visitasPorHora = await db
  .select({
    hora: sql<string>`strftime('%H', datetime(${visitas.createdAt}, '-4 hours'))`,
    total: sql<number>`count(*)`,
  })
  .from(visitas)
  .where(gte(visitas.createdAt, toUtcISO(hace7Dias)))
  .groupBy(sql`strftime('%H', datetime(${visitas.createdAt}, '-4 hours'))`)
  .orderBy(sql`strftime('%H', datetime(${visitas.createdAt}, '-4 hours'))`);

const maxVisitasHora = Math.max(1, ...visitasPorHora.map(v => Number(v.total)));

// Reportes por día (últimos 7 días)
const reportesPorDia = await db
  .select({
    dia: sql<string>`date(datetime(${reportes.createdAt}, '-4 hours'))`,
    total: sql<number>`count(*)`,
  })
  .from(reportes)
  .where(gte(reportes.createdAt, toUtcISO(hace7Dias)))
  .groupBy(sql`date(datetime(${reportes.createdAt}, '-4 hours'))`)
  .orderBy(sql`date(datetime(${reportes.createdAt}, '-4 hours'))`);

const maxReportesDia = Math.max(1, ...reportesPorDia.map(v => Number(v.total)));

// Helper para nombre corto de día en Caracas
const NOMBRES_DIA = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
function diaCorto(iso: string): string {
  const d = new Date(iso + 'T00:00:00Z');
  const caracas = new Date(d.getTime() - 4 * 3600 * 1000);
  return NOMBRES_DIA[caracas.getUTCDay()];
}
function horaCaracasLabel(hora: string): string {
  return `${hora}:00`;
}

// Detectar si una fecha UTC cae hoy (día Caracas)
function esHoy(iso: string): boolean {
  const caracas = utcToCaracas(new Date(iso));
  const hoyCaracas = utcToCaracas(new Date());
  return (
    caracas.getUTCFullYear() === hoyCaracas.getUTCFullYear() &&
    caracas.getUTCMonth() === hoyCaracas.getUTCMonth() &&
    caracas.getUTCDate() === hoyCaracas.getUTCDate()
  );
}
---

<Layout title="Dashboard - FarmaGuardia Admin" hideFooter>
  <div class="min-h-full flex">
    <AdminSidebar active="dashboard" />

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-w-0">
      <!-- Topbar (móvil) -->
      <div class="md:hidden flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800">
        <span class="font-bold text-gray-900 dark:text-gray-100">FarmaGuardia Admin</span>
        <div class="flex gap-2">
          <a href="/admin/farmacias" class="text-sm text-primary">Farmacias</a>
          <a href="/admin/turnos" class="text-sm text-primary">Turnos</a>
          <a href="/" class="text-sm text-primary">Landing</a>
        </div>
      </div>

      <main class="flex-1 p-4 sm:p-6 overflow-x-clip">
        <div class="flex items-center justify-between mb-6 gap-3 flex-wrap">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Dashboard</h1>
          <form method="POST" action={actions.testTelegram}>
            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors whitespace-nowrap">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Test Telegram
            </button>
          </form>
        </div>

        {resultTelegram?.error && (
          <div class="mb-6 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-sm text-red-700 dark:text-red-300">
            {resultTelegram.error.message}
          </div>
        )}
        {resultTelegram?.data?.ok && (
          <div class="mb-6 p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-sm text-green-700 dark:text-green-300">
            Mensaje de prueba enviado. Revisa tu Telegram.
          </div>
        )}

        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
          <div class="relative overflow-hidden bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
            <svg class="absolute -top-4 -right-4 w-28 h-28 text-sky-100 dark:text-sky-900/40 rotate-[-12deg]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <p class="relative text-sm text-gray-500 dark:text-gray-400">Farmacias activas</p>
            <p class="relative text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">{farmaciasActivas.length} / {Number(totalFarmacias)}</p>
          </div>
          <div class="relative overflow-hidden bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
            <svg class="absolute -top-4 -right-4 w-28 h-28 text-emerald-100 dark:text-emerald-900/40 rotate-[12deg]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="relative text-sm text-gray-500 dark:text-gray-400">Turnos totales</p>
            <p class="relative text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">{Number(totalTurnos)}</p>
          </div>
          <div class="relative overflow-hidden bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
            <svg class="absolute -top-4 -right-4 w-28 h-28 text-red-100 dark:text-red-900/40 rotate-[-8deg]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <p class="relative text-sm text-gray-500 dark:text-gray-400">Reportes</p>
            <p class="relative text-2xl font-bold text-gray-900 dark:text-gray-100 mt-1">{Number(totalReportes)}</p>
          </div>
        </div>

        <!-- Turnos activos -->
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">Turnos activos ahora ({turnosActivos.length})</h2>
          {turnosActivos.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {turnosActivos.map(t => (
                <div class="bg-primary text-white rounded-xl p-4 sm:p-5">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                    <div>
                      <p class="text-sm opacity-90">{t.nombre} {t.sector && `· ${t.sector}`}</p>
                      <p class="text-xs opacity-75 mt-1">
                        {formatCaracasDateTime(new Date(t.inicio))} → {formatCaracasDateTime(new Date(t.fin))}
                      </p>
                    </div>
                    <span class="inline-flex items-center gap-1.5 bg-white/20 px-3 py-1 rounded-full text-sm font-medium animate-pulse-slow w-fit">
                      <span class="w-2 h-2 bg-white rounded-full"></span>
                      ACTIVO
                    </span>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-4 text-amber-800 dark:text-amber-200">
              No hay turnos activos en este momento.
            </div>
          )}
        </div>

        <!-- Próximos turnos -->
        <div class="mb-8">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Próximos turnos</h2>
            <a href="/admin/turnos" class="text-sm text-primary hover:underline">Gestionar →</a>
          </div>
          <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr class="text-left text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                  <th class="px-4 py-2">Farmacia</th>
                  <th class="px-4 py-2 hidden sm:table-cell">Inicio</th>
                  <th class="px-4 py-2 hidden sm:table-cell">Fin</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
                {proximos.map(t => (
                  <tr class:list={['transition-colors', esHoy(t.inicio) ? 'bg-sky-50/60 dark:bg-sky-900/10' : 'hover:bg-gray-50 dark:hover:bg-gray-800/50']}>
                    <td class="px-4 py-2.5">
                      <p class="font-medium text-gray-900 dark:text-gray-100">{t.nombre}</p>
                      {esHoy(t.inicio) && (
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-semibold uppercase bg-sky-100 dark:bg-sky-900/40 text-sky-700 dark:text-sky-300 rounded-full">
                          <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                          Hoy
                        </span>
                      )}
                    </td>
                    <td class="px-4 py-2.5 hidden sm:table-cell">
                      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 rounded-lg whitespace-nowrap">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        {formatCaracasDateTime(new Date(t.inicio))}
                      </span>
                    </td>
                    <td class="px-4 py-2.5 hidden sm:table-cell">
                      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-lg whitespace-nowrap">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13l-3 3m0 0l-3-3m3 3V8m0 13a9 9 0 110-18 9 9 0 010 18z" /></svg>
                        {formatCaracasDateTime(new Date(t.fin))}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Analytics -->
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">Analytics (últimos 7 días)</h2>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4">
            <!-- Visitas por día -->
            <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300">Visitas por día</h3>
                <span class="text-xs text-gray-500 dark:text-gray-400">{totalVisitasSemana} en total</span>
              </div>
              {visitasPorDia.length > 0 ? (
                <div class="flex items-end gap-1.5 h-16">
                  {visitasPorDia.map(v => (
                    <div class="flex-1 flex flex-col items-center gap-1 min-w-0">
                      <span class="text-[10px] text-gray-500 dark:text-gray-400">{Number(v.total)}</span>
                      <div
                        class="w-full bg-primary/80 rounded-t"
                        style={`height: ${Math.max(3, (Number(v.total) / maxVisitasDia) * 40)}px`}
                      ></div>
                      <span class="text-[10px] text-gray-500 dark:text-gray-400 truncate">{diaCorto(v.dia)}</span>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="text-sm text-gray-500 dark:text-gray-400 py-6 text-center">Sin visitas registradas aún.</p>
              )}
            </div>

            <!-- Horarios pico -->
            <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
              <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Horarios pico (hora Caracas)</h3>
              {visitasPorHora.length > 0 ? (
                <div class="flex items-end gap-0.5 h-16">
                  {visitasPorHora.map(v => (
                    <div class="flex-1 flex flex-col items-center gap-1 min-w-0" title={`${horaCaracasLabel(v.hora)}: ${Number(v.total)} visitas`}>
                      <div
                        class="w-full bg-emerald-500/80 rounded-t"
                        style={`height: ${Math.max(3, (Number(v.total) / maxVisitasHora) * 40)}px`}
                      ></div>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="text-sm text-gray-500 dark:text-gray-400 py-6 text-center">Sin datos de horarios aún.</p>
              )}
              {visitasPorHora.length > 0 && (
                <p class="text-[10px] text-gray-500 dark:text-gray-400 mt-2">
                  0h → 23h · el más alto: {visitasPorHora.reduce((a, b) => Number(b.total) > Number(a.total) ? b : a).hora}:00
                </p>
              )}
            </div>

            <!-- Reportes por día -->
            <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4">
              <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Reportes por día</h3>
              {reportesPorDia.length > 0 ? (
                <div class="flex items-end gap-1.5 h-16">
                  {reportesPorDia.map(v => (
                    <div class="flex-1 flex flex-col items-center gap-1 min-w-0">
                      <span class="text-[10px] text-gray-500 dark:text-gray-400">{Number(v.total)}</span>
                      <div
                        class="w-full bg-red-500/80 rounded-t"
                        style={`height: ${Math.max(3, (Number(v.total) / maxReportesDia) * 40)}px`}
                      ></div>
                      <span class="text-[10px] text-gray-500 dark:text-gray-400 truncate">{diaCorto(v.dia)}</span>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="text-sm text-gray-500 dark:text-gray-400 py-4 text-center">Sin reportes en los últimos 7 días.</p>
              )}
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>