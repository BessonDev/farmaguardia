---
// src/pages/admin/farmacias.astro
import { db } from '../../db';
import { farmacias } from '../../db/schema';
import { eq } from 'drizzle-orm';

// Get edit ID from query params
const editId = Astro.url.searchParams.get('edit');
let farmaciaToEdit = null;
if (editId) {
  const result = await db.select().from(farmacias).where(eq(farmacias.id, parseInt(editId))).get();
  farmaciaToEdit = result;
}

// Handle form submission
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('_action') as string;

  if (action === 'create') {
    // Insert new farmacia
    await db.insert(farmacias).values({
      nombre: formData.get('nombre') as string,
      direccion: formData.get('direccion') as string,
      telefono: formData.get('telefono') as string || null,
      whatsapp: formData.get('whatsapp') as string || null,
      latitud: formData.get('latitud') ? parseFloat(formData.get('latitud') as string) : null,
      longitud: formData.get('longitud') ? parseFloat(formData.get('longitud') as string) : null,
      imagen_url: formData.get('imagen_url') as string || null,
      activa: formData.get('activa') ? 1 : 0,
      entrega: formData.get('entrega') ? 1 : 0 // Note: using 'entrega' to match the seed data? Actually we used 'delivery' in seed, but in schema we have 'delivery'. Let's check.
    });
  } else if (action === 'update' && editId) {
    // Update existing farmacia
    await db.update(farmacias).set({
      nombre: formData.get('nombre') as string,
      direccion: formData.get('direccion') as string,
      telefono: formData.get('telefono') as string || null,
      whatsapp: formData.get('whatsapp') as string || null,
      latitud: formData.get('latitud') ? parseFloat(formData.get('latitud') as string) : null,
      longitud: formData.get('longitud') ? parseFloat(formData.get('longitud') as string) : null,
      imagen_url: formData.get('imagen_url') as string || null,
      activa: formData.get('activa') ? 1 : 0,
      entrega: formData.get('entrega') ? 1 : 0
    }).where(eq(farmacias.id, parseInt(editId)));
  } else if (action === 'delete') {
    const idToDelete = formData.get('id') as string;
    if (idToDelete) {
      await db.delete(farmacias).where(eq(farmacias.id, parseInt(idToDelete)));
    }
  }

  // After processing, redirect to the same page to avoid form resubmission
  return new Response(null, {
    status: 302,
    headers: {
      Location: '/admin/farmacias' // Remove any query parameters
    }
  });
}

// Fetch all farmacias for the list
const allFarmacias = await db.select().from(farmacias);
---
<layout>
  <div class="space-y-6">
    {/* Header with title and buttons */}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
        Gestión de Farmacias
      </h1>
      <div class="flex space-x-3 mt-4 sm:mt-0">
        <a 
          href="/admin/farmacias?edit=new" 
          class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded"
        >
          Nueva Farmacia
        </a>
        <a 
          href="/admin/" 
          class="bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded"
        >
          Volver al Panel
        </a>
      </div>
    </div>

    {/* Form for creating/editing */}
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        {farmaciaToEdit ? 'Editar Farmacia' : 'Nueva Farmacia'}
      </h2>
      <form method="POST" class="space-y-4">
        <input type="hidden" name="_action" value={farmaciaToEdit ? 'update' : 'create'} />
        {farmaciaToEdit && (
          <input type="hidden" name="id" value={farmaciaToEdit.id} />
        )}

        <div>
          <label for="nombre" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Nombre *
          </label>
          <input 
            type="text" 
            id="nombre" 
            name="nombre"
            required
            value={farmaciaToEdit?.nombre || ''}
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          />
        </div>

        <div>
          <label for="direccion" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Dirección *
          </label>
          <input 
            type="text" 
            id="direccion" 
            name="direccion"
            required
            value={farmaciaToEdit?.direccion || ''}
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="telefono" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              Teléfono
            </label>
            <input 
              type="text" 
              id="telefono" 
              name="telefono"
              value={farmaciaToEdit?.telefono || ''}
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
            />
          </div>
          <div>
            <label for="whatsapp" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              WhatsApp
            </label>
            <input 
              type="text" 
              id="whatsapp" 
              name="whatsapp"
              value={farmaciaToEdit?.whatsapp || ''}
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
            />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="latitud" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              Latitud
            </label>
            <input 
              type="number" 
              step="any"
              id="latitud" 
              name="latitud"
              value={farmaciaToEdit?.latitud || ''}
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
            />
          </div>
          <div>
            <label for="longitud" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              Longitud
            </label>
            <input 
              type="number" 
              step="any"
              id="longitud" 
              name="longitud"
              value={farmaciaToEdit?.longitud || ''}
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
            />
          </div>
        </div>

        <div>
          <label for="imagen_url" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            URL de Imagen
          </label>
          <input 
            type="text" 
            id="imagen_url" 
            name="imagen_url"
            value={farmaciaToEdit?.imagenUrl || ''}
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          />
        </div>

        <div class="flex items-center space-x-4">
          <div class="flex items-center">
            <input 
              type="checkbox" 
              id="activa" 
              name="activa"
              checked={farmaciaToEdit?.activa === 1}
              class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
            />
            <label for="activa" class="text-sm font-medium text-gray-700 dark:text-gray-300">
              Activa
            </label>
          </div>
          <div class="flex items-center">
            <input 
              type="checkbox" 
              id="entrega" 
              name="entrega"
              checked={farmaciaToEdit?.entrega === 1}
              class="h-4 w-4 text-emerald-600 focus:ring-emerald-500 border-gray-300 rounded"
            />
            <label for="entrega" class="text-sm font-medium text-gray-700 dark:text-gray-300">
              Servicio de Envío
            </label>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <button 
            type="submit" 
            class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded"
          >
            {farmaciaToEdit ? 'Actualizar' : 'Crear'}
          </button>
          {farmaciaToEdit && (
            <a 
              href="/admin/farmacias" 
              class="text-sm text-gray-600 hover:text-gray-900 dark:hover:text-gray-100"
            >
              Cancelar
            </a>
          )}
        </div>
      </form>
    </div>

    {/* List of farmacias */}
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md">
      <div class="px-6 py-4">
        <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4">
          Lista de Farmacias
        </h2>
        {allFarmacias.length > 0 ? (
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-700">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                  Nombre
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                  Dirección
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                  Teléfono
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                  WhatsApp
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                  Estado
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                  Acciones
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              {allFarmacias.map((farmacia, index) => (
                <tr key={farmacia.id} class="hover:bg-gray-50 dark:hover:bg-gray-700">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">
                    {farmacia.nombre}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">
                    {farmacia.direccion}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">
                    {farmacia.telefono || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">
                    {farmacia.whatsapp || '-'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm flex items-center">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                      {farmacia.activa === 1 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                      {farmacia.activa === 1 ? 'Activa' : 'Inactiva'}
                    </span>
                    <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                      {farmacia.entrega === 1 ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                      {farmacia.entrega === 1 ? 'Envío' : 'Sin Envío'}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <div class="flex space-x-2">
                      <a 
                        href={`/admin/farmacias?edit=${farmacia.id}`} 
                        class="text-indigo-600 hover:text-indigo-900 dark:hover:text-gray-100"
                      >
                        Editar
                      </a>
                      <form 
                        method="POST" 
                        class="d-inline"
                        onsubmit="return confirm('¿Está seguro de que desea eliminar esta farmacia? Esta acción no se puede deshacer.');"
                      >
                        <input type="hidden" name="_action" value="delete" />
                        <input type="hidden" name="id" value={farmacia.id} />
                        <button 
                          type="submit"
                          class="text-red-600 hover:text-red-900 dark:hover:text-gray-100"
                        >
                          Eliminar
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <div class="text-center py-8">
            <p class="text-gray-500 dark:text-gray-400">
              No hay farmacias registradas aún.
            </p>
          </div>
        )}
      </div>
    </div>
  </div>
</layout>
