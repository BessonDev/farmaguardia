---
// src/pages/admin/farmacias.astro
import { db } from '../../db';
import { farmacias } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { getCookie } from 'cookie';

// Simple auth check
const request = Astro.request;
const cookies = request.headers.get('cookie') ?? '';
const authCookie = cookies.split('; ').find(row => row.startsWith('admin_token='));
const isAuthenticated = authCookie && authCookie.split('=')[1] === import.meta.env.ADMIN_PASSWORD;

if (!isAuthenticated) {
  return Astro.redirect('/admin/login');
}

// Handle form submissions
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (action === 'create') {
    const nombre = formData.get('nombre') as string;
    const direccion = formData.get('direccion') as string;
    const telefono = formData.get('telefono') as string || null;
    const whatsapp = formData.get('whatsapp') as string || null;
    const sector = formData.get('sector') as string || 'Centro';
    const latitud = formData.get('latitud') ? parseFloat(formData.get('latitud') as string) : null;
    const longitud = formData.get('longitud') ? parseFloat(formData.get('longitud') as string) : null;
    const imagenUrl = formData.get('imagenUrl') as string || null;
    const entrega = formData.get('entrega') === 'on' ? 1 : 0;

    await db.insert(farmacias).values({
      nombre,
      direccion,
      telefono,
      whatsapp,
      sector,
      latitud,
      longitud,
      imagenUrl,
      activa: 1,
      entrega
    });

    return Astro.redirect('/admin/farmacias');
  }

  if (action === 'update') {
    const id = parseInt(formData.get('id') as string);
    const nombre = formData.get('nombre') as string;
    const direccion = formData.get('direccion') as string;
    const telefono = formData.get('telefono') as string || null;
    const whatsapp = formData.get('whatsapp') as string || null;
    const sector = formData.get('sector') as string || 'Centro';
    const latitud = formData.get('latitud') ? parseFloat(formData.get('latitud') as string) : null;
    const longitud = formData.get('longitud') ? parseFloat(formData.get('longitud') as string) : null;
    const imagenUrl = formData.get('imagenUrl') as string || null;
    const entrega = formData.get('entrega') === 'on' ? 1 : 0;
    const activa = formData.get('activa') === 'on' ? 1 : 0;

    await db.update(farmacias).set({
      nombre,
      direccion,
      telefono,
      whatsapp,
      sector,
      latitud,
      longitud,
      imagenUrl,
      activa,
      entrega
    }).where(eq(farmacias.id, id));

    return Astro.redirect('/admin/farmacias');
  }

  if (action === 'delete') {
    const id = parseInt(formData.get('id') as string);
    await db.delete(farmacias).where(eq(farmacias.id, id));
    return Astro.redirect('/admin/farmacias');
  }
}

// Fetch all farmacias
const allFarmacias = await db.select().from(farmacias).orderBy(farmacias.nombre);
---
<layout>
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Gestión de Farmacias</h1>
      <a href="/admin/farmacias/nuevo" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded">
        Nueva Farmacia
      </a>
    </div>

    {/* Mensaje de éxito o error (se puede implementar con flash messages) */}
    {/* Por ahora, asumimos que la redirect maneja el feedback */}

    <div class="overflow-x-auto">
      <table class="min-w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-700">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Nombre</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Dirección</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Sector</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Teléfono</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">WhatsApp</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Entrega</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:border-gray-700">
          {allFarmacias.map(farmacia => (
            <tr key={farmacia.id} class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-4 py-2 text-sm font-medium text-gray-900 dark:text-gray-100">{farmacia.nombre}</td>
              <td class="px-4 py-2 text-sm text-gray-700 dark:text-gray-300">{farmacia.direccion}</td>
              <td class="px-4 py-2 text-sm text-gray-700 dark:text-gray-300">{farmacia.sector}</td>
              <td class="px-4 py-2 text-sm text-gray-700 dark:text-gray-300">{farmacia.telefono ?? '-'}</td>
              <td class="px-4 py-2 text-sm text-gray-700 dark:text-gray-300">{farmacia.whatsapp ?? '-'}</td>
              <td class="px-4 py-2 text-sm text-gray-700 dark:text-gray-300">
                {farmacia.entrega ? (
                  <span class="flex items-center">
                    <svg class="w-4 h-4 mr-1 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Sí
                  </span>
                ) : (
                  <span class="text-gray-500">No</span>
                )}
              </td>
              <td class="px-4 py-2 text-sm space-x-2">
                <form method="POST" action="/admin/farmacias" class="inline">
                  <input type="hidden" name="action" value="edit" />
                  <input type="hidden" name="id" value={farmacia.id} />
                  <button type="submit" class="text-blue-600 hover:text-blue-900 hover:underline" title="Editar">
                    Editar
                  </button>
                </form>
                <form method="POST" action="/admin/farmacias" class="inline" onsubmit="return confirm('¿Está seguro de eliminar esta farmacia?');">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={farmacia.id} />
                  <button type="submit" class="text-red-600 hover:text-red-900 hover:underline" title="Eliminar">
                    Eliminar
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</layout>