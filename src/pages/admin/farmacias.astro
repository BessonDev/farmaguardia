---
import Layout from '../../layouts/Layout.astro';
import { actions } from 'astro:actions';
import { db } from '../../db';
import { farmacias } from '../../db/schema';
import { eq, asc } from 'drizzle-orm';

const result = Astro.getActionResult(actions.crearFarmacia) ?? Astro.getActionResult(actions.editarFarmacia) ?? Astro.getActionResult(actions.eliminarFarmacia);

const lista = await db.select().from(farmacias).orderBy(asc(farmacias.nombre));

const url = new URL(Astro.url);
const editId = url.searchParams.get('editar');
const editando = editId ? lista.find(f => f.id === Number(editId)) : null;
---

<Layout title="Farmacias - FarmaGuardia Admin">
  <div class="min-h-full flex">
    <aside class="hidden md:flex flex-col w-56 border-r border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50 shrink-0">
      <div class="p-4 border-b border-gray-200 dark:border-gray-800">
        <div class="flex items-center gap-2">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="font-bold text-gray-900 dark:text-gray-100">FarmaGuardia</span>
        </div>
        <p class="text-xs text-gray-500 mt-1">Panel de Administración</p>
      </div>
      <nav class="flex-1 p-3 space-y-1">
        <a href="/admin" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10" />
          </svg>
          Dashboard
        </a>
        <a href="/admin/farmacias" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-primary text-white font-medium text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          Farmacias
        </a>
        <a href="/admin/turnos" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Turnos
        </a>
        <a href="/" target="_blank" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Ver landing
        </a>
      </nav>
      <div class="p-3 border-t border-gray-200 dark:border-gray-800">
        <form method="POST" action={actions.logout}>
          <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20">
            Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
      <div class="md:hidden flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800">
        <span class="font-bold text-gray-900 dark:text-gray-100">Farmacias</span>
        <div class="flex gap-2">
          <a href="/admin" class="text-sm text-primary">Dashboard</a>
          <a href="/admin/turnos" class="text-sm text-primary">Turnos</a>
        </div>
      </div>

      <main class="flex-1 p-4 sm:p-6 overflow-x-hidden">
        <div class="flex items-center justify-between mb-6">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Farmacias</h1>
          {!editando && (
            <a href="#nueva" class="px-4 py-2 bg-primary hover:bg-primary-dark text-white text-sm font-medium rounded-lg transition-colors">
              + Nueva
            </a>
          )}
        </div>

        {result?.error && (
          <div class="mb-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-sm text-red-700 dark:text-red-300">
            {result.error.message}
          </div>
        )}
        {result?.data?.ok && (
          <div class="mb-4 p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-sm text-green-700 dark:text-green-300">
            Operación exitosa.
          </div>
        )}

        <!-- Formulario (nueva o editar) -->
        <div id="nueva" class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm p-4 sm:p-6 mb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
            {editando ? `Editar: ${editando.nombre}` : 'Nueva farmacia'}
          </h2>
          <form method="POST" action={editando ? actions.editarFarmacia : actions.crearFarmacia} class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {editando && <input type="hidden" name="id" value={editando.id} />}
            <div class="sm:col-span-2">
              <label for="nombre" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nombre *</label>
              <input type="text" id="nombre" name="nombre" required value={editando?.nombre ?? ''} class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
            </div>
            <div class="sm:col-span-2">
              <label for="direccion" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Dirección *</label>
              <input type="text" id="direccion" name="direccion" required value={editando?.direccion ?? ''} class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
            </div>
            <div>
              <label for="sector" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Sector</label>
              <input type="text" id="sector" name="sector" value={editando?.sector ?? 'Centro'} class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
            </div>
            <div>
              <label for="telefono" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Teléfono</label>
              <input type="text" id="telefono" name="telefono" value={editando?.telefono ?? ''} placeholder="0248-5210171" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
            </div>
            <div>
              <label for="whatsapp" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">WhatsApp</label>
              <input type="text" id="whatsapp" name="whatsapp" value={editando?.whatsapp ?? ''} placeholder="0412-1234567" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="latitud" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Latitud</label>
                <input type="number" step="any" id="latitud" name="latitud" value={editando?.latitud ?? ''} placeholder="5.6667" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
              </div>
              <div>
                <label for="longitud" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Longitud</label>
                <input type="number" step="any" id="longitud" name="longitud" value={editando?.longitud ?? ''} placeholder="-67.6333" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
              </div>
            </div>
            <div class="sm:col-span-2 flex flex-wrap items-center gap-4 pt-2">
              <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                <input type="checkbox" name="delivery" {editando?.delivery ? 'checked' : ''} class="w-4 h-4 text-primary border-gray-300 dark:border-gray-600 rounded" />
                Delivery disponible
              </label>
              {editando && (
                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                  <input type="checkbox" name="activa" {editando?.activa ? 'checked' : ''} class="w-4 h-4 text-primary border-gray-300 dark:border-gray-600 rounded" />
                  Activa
                </label>
              )}
            </div>
            <div class="sm:col-span-2 flex gap-3 pt-2">
              <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary-dark text-white text-sm font-medium rounded-lg transition-colors">
                {editando ? 'Guardar cambios' : 'Crear farmacia'}
              </button>
              {editando && (
                <a href="/admin/farmacias" class="px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800">
                  Cancelar
                </a>
              )}
            </div>
          </form>
        </div>

        <!-- Listado -->
        <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr class="text-left text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                  <th class="px-4 py-3">Nombre</th>
                  <th class="px-4 py-3 hidden md:table-cell">Sector</th>
                  <th class="px-4 py-3 hidden lg:table-cell">Teléfono</th>
                  <th class="px-4 py-3">Estado</th>
                  <th class="px-4 py-3 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
                {lista.map(f => (
                  <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
                    <td class="px-4 py-3">
                      <p class="font-medium text-gray-900 dark:text-gray-100">{f.nombre}</p>
                      <p class="text-xs text-gray-500 dark:text-gray-400 truncate max-w-[220px] lg:max-w-xs">{f.direccion}</p>
                    </td>
                    <td class="px-4 py-3 text-gray-600 dark:text-gray-300 hidden md:table-cell">{f.sector}</td>
                    <td class="px-4 py-3 text-gray-600 dark:text-gray-300 hidden lg:table-cell">{f.telefono || '—'}</td>
                    <td class="px-4 py-3">
                      <span class={`inline-flex px-2 py-0.5 text-xs font-medium rounded-full ${f.activa ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400' : 'bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400'}`}>
                        {f.activa ? 'Activa' : 'Inactiva'}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                      <a href={`/admin/farmacias?editar=${f.id}`} class="text-primary hover:underline mr-3">Editar</a>
                      <form method="POST" action={actions.eliminarFarmacia} class="inline" onsubmit="return confirm('¿Eliminar esta farmacia? Se eliminarán sus turnos.')">
                        <input type="hidden" name="id" value={f.id} />
                        <button type="submit" class="text-red-600 dark:text-red-400 hover:underline">Eliminar</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>