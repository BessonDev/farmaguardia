---
import LayoutAdmin from '~/layouts/LayoutAdmin.astro';
import { db, schema } from '~/db/client';
import { cookies, makeCsrfToken } from '~/lib/auth';

const plantillaId = Number(Astro.url.searchParams.get('plantilla_id'));

const plantillas = db.select().from(schema.plantillas).orderBy(schema.plantillas.nombre).all();

const csrfToken = makeCsrfToken();
Astro.cookies.set(cookies.csrf, csrfToken, { path: '/', httpOnly: false, sameSite: 'lax', secure: import.meta.env.PROD, maxAge: 86400 });

const error = Astro.url.searchParams.get('error');
---

<LayoutAdmin title="Aplicar plantilla">
  <h2>Aplicar plantilla de rotación</h2>

  <div class="card" style="max-width: 640px;">
    <p style="font-size: 14px; color: var(--fg-muted); margin: 0 0 16px;">
      Generá todos los turnos para un rango de fechas usando una plantilla existente. Los turnos se crean automáticamente siguiendo el orden de rotación.
    </p>

    {error === 'required' && <div class="alert danger">Las fechas de inicio y fin son obligatorias.</div>}
    {error === 'csrf' && <div class="alert danger">Error de seguridad. Intentalo de nuevo.</div>}
    {error === 'invalid' && <div class="alert danger">Plantilla inválida.</div>}
    {error === 'emptyslots' && <div class="alert danger">La plantilla no tiene farmacias asignadas.</div>}

    <form method="post" action={`/admin/api/plantillas/${plantillaId}/aplicar`}>
      <input type="hidden" name="_csrf" value={csrfToken} />

      <label class="field">
        <span>Plantilla *</span>
        <select name="plantilla_id" required onchange={`this.form.action='/admin/api/plantillas/'+this.value+'/aplicar'`}>
          <option value="">Seleccionar plantilla</option>
          {plantillas.map((p) => (
            <option value={p.id} selected={p.id === plantillaId}>{p.nombre}</option>
          ))}
        </select>
      </label>

      <div class="form-grid">
        <label class="field">
          <span>Desde *</span>
          <input name="desde" type="date" required />
        </label>
        <label class="field">
          <span>Hasta *</span>
          <input name="hasta" type="date" required />
        </label>
      </div>

      <div class="form-grid">
        <label class="field">
          <span>Hora de inicio</span>
          <input name="hora_inicio" type="time" value="08:00" />
        </label>
        <label class="field">
          <span>Hora de fin</span>
          <input name="hora_fin" type="time" value="08:00" />
        </label>
      </div>

      <div style="margin-top: 16px; display: flex; gap: 8px;">
        <button type="submit" class="primary">Generar turnos</button>
        <a href="/admin/plantillas" class="secondary">Cancelar</a>
      </div>
    </form>
  </div>
</LayoutAdmin>
