---
import LayoutAdmin from '~/layouts/LayoutAdmin.astro';
import { db, schema } from '~/db/client';
import { cookies, makeCsrfToken } from '~/lib/auth';
import { sql, desc } from 'drizzle-orm';

const plantillas = db
  .select({
    id: schema.plantillas.id,
    nombre: schema.plantillas.nombre,
    createdAt: schema.plantillas.createdAt,
    slots: sql<number>`(SELECT COUNT(*) FROM plantilla_slots WHERE plantilla_slots.plantilla_id = plantillas.id)`,
  })
  .from(schema.plantillas)
  .orderBy(desc(schema.plantillas.createdAt))
  .all();

const csrfToken = makeCsrfToken();
Astro.cookies.set(cookies.csrf, csrfToken, { path: '/', httpOnly: false, sameSite: 'lax', maxAge: 86400 });

const okMsg = Astro.url.searchParams.get('ok');
const totalOk = Astro.url.searchParams.get('total');
const error = Astro.url.searchParams.get('error');
---

<LayoutAdmin title="Plantillas de rotación">
  <div class="toolbar">
    <h2 style="margin: 0; flex: 1;">Plantillas de rotación</h2>
    <a href="/admin/plantillas/nueva" class="primary">+ Nueva plantilla</a>
  </div>

  {okMsg === 'aplicado' && (
    <div class="alert success">{totalOk} turnos generados desde la plantilla.</div>
  )}

  {error === 'csrf' && <div class="alert danger">Error de seguridad. Intentalo de nuevo.</div>}

  <div class="card" style="padding: 0; overflow: hidden;">
    <table>
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Slots</th>
          <th>Creada</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {plantillas.map((p) => (
          <tr>
            <td style="font-weight: 600;">{p.nombre}</td>
            <td>{p.slots}</td>
            <td style="color: var(--fg-muted); font-size: 13px;">{new Date(p.createdAt).toLocaleDateString()}</td>
            <td style="display: flex; gap: 6px; justify-content: end;">
              <a href={`/admin/plantillas/aplicar?plantilla_id=${p.id}`} class="primary" style="font-size: 13px;">Aplicar</a>
              <form method="post" action={`/admin/plantillas/${p.id}/borrar`} style="display: inline;">
                <input type="hidden" name="_csrf" value={csrfToken} />
                <button type="submit" class="danger" onclick="return confirm('¿Borrar esta plantilla y todos sus slots?')">Borrar</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {plantillas.length === 0 && (
    <div class="card" style="text-align: center; color: var(--fg-muted);">
      No hay plantillas todavía. <a href="/admin/plantillas/nueva">Creá la primera</a>.
    </div>
  )}
</LayoutAdmin>
