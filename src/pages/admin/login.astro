---
// src/pages/admin/login.astro
import { getCookie, setCookie } from 'cookie';

// Handle login POST
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = formData.get('password') as string;
  
  // Compare with environment variable
  if (password === import.meta.env.ADMIN_PASSWORD) {
    // Set a simple cookie (in production, use JWT or session)
    const headers = new Headers();
    setCookie(headers, 'admin_token', password, {
      httpOnly: true,
      path: '/',
      maxAge: 60 * 60 * 24 // 1 day
    });
    
    return new Response(null, {
      status: 302,
      headers: {
        Location: '/admin/',
        ...Object.fromEntries(headers)
      }
    });
  } else {
    // Invalid credentials
    return new Response(null, {
      status: 302,
      headers: {
        Location: '/admin/login?error=1'
      }
    });
  }
}

// GET request - show login form
const error = Astro.url.searchParams.get('error') === '1';
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FarmaGuardia - Iniciar Sesión</title>
    <meta name="description" content="Inicia sesión para acceder al panel de administración de FarmaGuardia" />
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 flex min-h-screen items-center justify-center">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md w-full max-w-sm p-6 space-y-6">
      <div class="text-center">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">FarmaGuardia Admin</h1>
        <p class="text-gray-600 dark:text-gray-400">Acceso al panel de administración</p>
      </div>
      
      {error && (
        <div class="bg-red-50 text-red-500 p-3 rounded-lg border border-red-200">
          Credenciales incorrectas. Por favor, inténtalo de nuevo.
        </div>
      )}
      
      <form method="POST" class="space-y-4">
        <div>
          <label for="password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Contraseña de Administrador
          </label>
          <input 
            type="password" 
            id="password" 
            name="password"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          />
        </div>
        
        <div class="flex items-center justify-between">
          <button type="submit" 
                  class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded">
            Ingresar
          </button>
        </div>
      </form>
      
      <p class="text-xs text-gray-500 dark:text-gray-400 text-center">
        Esta es una demostración. En producción, usar autenticación segura.
      </p>
    </div>
  </body>
</html>