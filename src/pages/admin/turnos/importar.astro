---
import LayoutAdmin from '~/layouts/LayoutAdmin.astro';
import { db, schema } from '~/db/client';
import { cookies, makeCsrfToken } from '~/lib/auth';
import { parse } from 'csv-parse/sync';
import { eq } from 'drizzle-orm';

const csrfToken = makeCsrfToken();
Astro.cookies.set(cookies.csrf, csrfToken, { path: '/', httpOnly: false, sameSite: 'lax', maxAge: 86400 });

const error = Astro.url.searchParams.get('error');
const okCount = Astro.url.searchParams.get('ok');
const failCount = Astro.url.searchParams.get('fail');

interface PreviewRow {
  nombre: string;
  fechaInicio: string;
  fechaFin: string;
  notas: string;
  valido: boolean;
  error?: string;
  farmaciaId?: number;
}

let preview: PreviewRow[] | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const file = formData.get('file') as File | null;

  if (file && file.size > 0) {
    const csvText = await file.text();
    const records: string[][] = parse(csvText, {
      skip_empty_lines: true,
      relax_column_count: true,
      delimiter: [',', ';', '\t'],
    });

    // Headers skip
    const rows = records.slice(1);

    const farmaciaCache = new Map(
      db.select({ nombre: schema.farmacias.nombre, id: schema.farmacias.id })
        .from(schema.farmacias)
        .all()
        .map((f) => [f.nombre.toLowerCase().trim(), f.id]),
    );

    preview = [];
    for (const row of rows) {
      const p: PreviewRow = {
        nombre: (row[0] ?? '').trim(),
        fechaInicio: (row[1] ?? '').trim(),
        fechaFin: (row[2] ?? '').trim(),
        notas: (row[3] ?? '').trim(),
        valido: true,
        error: undefined,
        farmaciaId: undefined,
      };

      if (!p.nombre) {
        p.valido = false;
        p.error = 'Nombre de farmacia vacío';
        preview.push(p);
        continue;
      }

      const farmId = farmaciaCache.get(p.nombre.toLowerCase());
      if (!farmId) {
        p.valido = false;
        p.error = `Farmacia "${p.nombre}" no encontrada`;
        preview.push(p);
        continue;
      }
      p.farmaciaId = farmId;

      if (!p.fechaInicio) {
        p.valido = false;
        p.error = 'Fecha de inicio vacía';
        preview.push(p);
        continue;
      }

      if (!/^\d{4}-\d{2}-\d{2}/.test(p.fechaInicio)) {
        p.valido = false;
        p.error = 'Formato fecha inicio inválido (usá YYYY-MM-DD HH:mm)';
        preview.push(p);
        continue;
      }

      if (p.fechaFin && !/^\d{4}-\d{2}-\d{2}/.test(p.fechaFin)) {
        p.valido = false;
        p.error = 'Formato fecha fin inválido (usá YYYY-MM-DD HH:mm)';
        preview.push(p);
        continue;
      }

      preview.push(p);
    }
  }
}
---

<LayoutAdmin title="Importar turnos">
  <h2>Importar turnos desde CSV</h2>

  {error === 'import' && (
    <div class="card" style="border-color: rgba(239,68,68,0.3); background: rgba(239,68,68,0.05);">
      <p style="margin:0; color:#fca5a5; font-size:14px;">Error al procesar el archivo. Verificá el formato.</p>
    </div>
  )}
  {okCount && (
    <div class="card" style="border-color: rgba(34,197,94,0.3); background: rgba(34,197,94,0.05);">
      <p style="margin:0; color:#22c55e; font-size:14px;">
        {okCount} turnos importados{failCount && failCount !== '0' ? `, ${failCount} fallaron` : ''}.
      </p>
    </div>
  )}

  {!preview && (
    <div class="card" style="max-width: 640px;">
      <p style="margin: 0 0 16px; color: var(--fg-muted); font-size: 14px;">
        Subí un archivo CSV con el formato: <code style="background: var(--bg); padding: 2px 6px; border-radius: 4px;">farmacia_nombre, fecha_inicio (YYYY-MM-DD HH:mm), fecha_fin (YYYY-MM-DD HH:mm, opcional), notas</code>
      </p>
      <form method="post" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <label class="field">
          <span>Archivo CSV</span>
          <input type="file" name="file" accept=".csv" required />
        </label>
        <div style="margin-top: 16px; display: flex; gap: 8px;">
          <button type="submit" class="primary">Previsualizar</button>
          <a href="/admin/turnos" class="secondary">Cancelar</a>
        </div>
      </form>
    </div>
  )}

  {preview && (
    <div class="card">
      <form method="post" action="/admin/api/turnos/importar" style="margin-bottom: 0;">
        <input type="hidden" name="_csrf" value={csrfToken} />

        <div style="overflow-x: auto;">
          <table>
            <thead>
              <tr>
                <th>Farmacia</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Notas</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {preview.map((row, i) => (
                <tr style={row.valido ? '' : 'opacity: 0.5;'}>
                  <td>{row.nombre}</td>
                  <td>{row.fechaInicio}</td>
                  <td>{row.fechaFin || '(24h)'}</td>
                  <td>{row.notas || '—'}</td>
                  <td>
                    {row.valido ? (
                      <>
                        <span class="badge green">OK</span>
                        <input type="hidden" name="rows" value={JSON.stringify({
                          farmaciaId: row.farmaciaId,
                          fechaInicio: row.fechaInicio,
                          fechaFin: row.fechaFin || null,
                          notas: row.notas || null,
                        })} />
                      </>
                    ) : (
                      <>
                        <span class="badge red">Error</span>
                        <span style="display: block; font-size: 11px; color: var(--danger); margin-top: 2px;">{row.error}</span>
                      </>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p style="margin: 12px 0; font-size: 13px; color: var(--fg-muted);">
          {preview.filter((r) => r.valido).length} filas válidas · {preview.filter((r) => !r.valido).length} errores
        </p>

        <div style="display: flex; gap: 8px;">
          <button type="submit" class="primary" {preview.filter((r) => r.valido).length === 0 ? 'disabled' : ''}>
            Importar {preview.filter((r) => r.valido).length} turnos
          </button>
          <a href="/admin/turnos/importar" class="secondary">Subir otro archivo</a>
          <a href="/admin/turnos" class="secondary">Volver</a>
        </div>
      </form>
    </div>
  )}

  <div class="card">
    <h3>Formato esperado</h3>
    <p style="margin: 0; font-size: 13px; color: var(--fg-muted);">
      La primera fila debe contener los encabezados (se ignoran).<br />
      <strong>Columnas:</strong> farmacia_nombre, fecha_inicio (YYYY-MM-DD HH:mm), fecha_fin (YYYY-MM-DD HH:mm, opcional), notas (opcional)<br />
      <strong>Separadores:</strong> coma, punto y coma o tabulación.<br />
      <strong>Ejemplo:</strong>
    </p>
    <pre style="margin: 8px 0 0; padding: 12px; background: var(--bg); border-radius: 8px; font-size: 12px; overflow-x: auto;">
farmacia_nombre,fecha_inicio,fecha_fin,notas
"Farma Amazonas (Sede Principal)",2026-08-15 08:00,2026-08-16 08:00,
"Farmacia Orinoco",2026-08-16 08:00,2026-08-17 08:00,"Feriado"</pre>
  </div>
</LayoutAdmin>
