---
import LayoutAdmin from '~/layouts/LayoutAdmin.astro';
import { db, schema } from '~/db/client';
import { cookies, makeCsrfToken } from '~/lib/auth';
import { formatFechaMiniCaracas, formatHoraCaracas } from '~/lib/tz';
import { eq, desc } from 'drizzle-orm';

const turnos = db
  .select({
    id: schema.turnos.id,
    inicioUtc: schema.turnos.inicioUtc,
    finUtc: schema.turnos.finUtc,
    notas: schema.turnos.notas,
    farmacia: schema.farmacias,
  })
  .from(schema.turnos)
  .innerJoin(schema.farmacias, eq(schema.turnos.farmaciaId, schema.farmacias.id))
  .orderBy(desc(schema.turnos.inicioUtc))
  .all();

const csrfToken = makeCsrfToken();
Astro.cookies.set(cookies.csrf, csrfToken, { path: '/', httpOnly: false, sameSite: 'lax', maxAge: 86400 });
---

<LayoutAdmin title="Turnos">
  <div class="toolbar">
    <h2 style="margin: 0; flex: 1;">Turnos</h2>
    <a href="/admin/turnos/nuevo" class="primary">+ Nuevo turno</a>
    <a href="/admin/turnos/importar" class="secondary">Importar CSV</a>
    <a href="/admin/turnos/historial" class="secondary">Historial</a>
  </div>

  <div class="card" style="padding: 0;">
    <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Farmacia</th>
          <th>Inicio</th>
          <th>Fin</th>
          <th>Notas</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {turnos.map((t) => (
          <tr>
            <td style="font-weight: 600;">{t.farmacia.nombre}</td>
            <td>
              <div>{formatFechaMiniCaracas(t.inicioUtc)}</div>
              <div style="font-size: 12px; color: var(--fg-muted);">{formatHoraCaracas(t.inicioUtc)}</div>
            </td>
            <td>
              <div>{formatFechaMiniCaracas(t.finUtc)}</div>
              <div style="font-size: 12px; color: var(--fg-muted);">{formatHoraCaracas(t.finUtc)}</div>
            </td>
            <td style="color: var(--fg-muted); font-size: 13px;">{t.notas ?? '—'}</td>
            <td>
              <form method="post" action={`/admin/turnos/${t.id}/borrar`} style="display: inline;">
                <input type="hidden" name="_csrf" value={csrfToken} />
                <button type="submit" class="danger" onclick="return confirm('¿Borrar este turno?')">Borrar</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>

  {turnos.length === 0 && (
    <div class="card" style="text-align: center; color: var(--fg-muted);">
      No hay turnos cargados.
    </div>
  )}
</LayoutAdmin>