---
import LayoutAdmin from '~/layouts/LayoutAdmin.astro';
import { db, schema } from '~/db/client';
import { cookies, makeCsrfToken } from '~/lib/auth';
import { formatHoraCaracas, formatFechaCortaCaracas, utcToCaracas } from '~/lib/tz';
import { eq, desc, lte, gte, and, sql } from 'drizzle-orm';
import { count } from 'drizzle-orm';

const csrfToken = makeCsrfToken();
Astro.cookies.set(cookies.csrf, csrfToken, { path: '/', httpOnly: false, sameSite: 'lax', maxAge: 86400 });

const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get('page')) || 1);
const limit = 50;
const offset = (page - 1) * limit;

const filterFarmacia = url.searchParams.get('farmacia') || '';
const filterDesde = url.searchParams.get('desde') || '';
const filterHasta = url.searchParams.get('hasta') || '';

const ahoraIso = new Date().toISOString();

const farmaciasList = db.select().from(schema.farmacias).orderBy(schema.farmacias.nombre).all();

// Build conditions
const conditions = [lte(schema.turnos.finUtc, ahoraIso)];
if (filterFarmacia) {
  conditions.push(eq(schema.turnos.farmaciaId, Number(filterFarmacia)));
}
if (filterDesde) {
  conditions.push(gte(schema.turnos.inicioUtc, `${filterDesde}T00:00:00.000Z`));
}
if (filterHasta) {
  conditions.push(lte(schema.turnos.inicioUtc, `${filterHasta}T23:59:59.999Z`));
}

const where = and(...conditions);

const [{ total }] = db
  .select({ total: count() })
  .from(schema.turnos)
  .where(where)
  .all();

const totalPages = Math.max(1, Math.ceil(total / limit));

const historial = db
  .select({
    id: schema.turnos.id,
    inicioUtc: schema.turnos.inicioUtc,
    finUtc: schema.turnos.finUtc,
    notas: schema.turnos.notas,
    farmacia: schema.farmacias,
    overrideId: schema.anunciosTurno.id,
    motivoOverride: schema.anunciosTurno.motivo,
    farmaciaSustitutaId: schema.anunciosTurno.farmaciaSustitutaId,
  })
  .from(schema.turnos)
  .innerJoin(schema.farmacias, eq(schema.turnos.farmaciaId, schema.farmacias.id))
  .leftJoin(schema.anunciosTurno, eq(schema.turnos.id, schema.anunciosTurno.turnoId))
  .where(where)
  .orderBy(desc(schema.turnos.inicioUtc))
  .limit(limit)
  .offset(offset)
  .all();

function buildQueryString(overrides: Record<string, string>): string {
  const params = new URLSearchParams();
  if (filterFarmacia) params.set('farmacia', filterFarmacia);
  if (filterDesde) params.set('desde', filterDesde);
  if (filterHasta) params.set('hasta', filterHasta);
  for (const [k, v] of Object.entries(overrides)) {
    if (v) params.set(k, v);
  }
  return params.toString();
}
---

<LayoutAdmin title="Historial de turnos">
  <h2>Historial de turnos</h2>

  <div class="card">
    <form method="get" class="form-grid" style="align-items: end;">
      <label class="field" style="margin: 0;">
        <span>Farmacia</span>
        <select name="farmacia">
          <option value="">Todas</option>
          {farmaciasList.map((f) => (
            <option value={f.id} selected={filterFarmacia === String(f.id)}>{f.nombre}</option>
          ))}
        </select>
      </label>
      <label class="field" style="margin: 0;">
        <span>Desde</span>
        <input type="date" name="desde" value={filterDesde} />
      </label>
      <label class="field" style="margin: 0;">
        <span>Hasta</span>
        <input type="date" name="hasta" value={filterHasta} />
      </label>
      <button type="submit" class="primary">Filtrar</button>
    </form>
  </div>

  <div class="card" style="padding: 0;">
    {historial.length === 0 ? (
      <div style="padding: 32px; text-align: center; color: var(--fg-muted); font-size: 14px;">
        No se encontraron turnos pasados con esos filtros.
      </div>
    ) : (
      <div style="overflow-x: auto;">
        <table>
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Farmacia</th>
              <th>Inicio</th>
              <th>Fin</th>
              <th>Override</th>
              <th>Notas</th>
            </tr>
          </thead>
          <tbody>
            {historial.map((t) => {
              const inicioDate = utcToCaracas(t.inicioUtc);
              const fechaLabel = formatFechaCortaCaracas(t.inicioUtc);
              return (
                <tr>
                  <td style="white-space: nowrap;">{fechaLabel}</td>
                  <td style="white-space: nowrap;">{t.farmacia.nombre}</td>
                  <td style="white-space: nowrap;">{formatHoraCaracas(t.inicioUtc)}</td>
                  <td style="white-space: nowrap;">{formatHoraCaracas(t.finUtc)}</td>
                  <td>
                    {t.overrideId ? (
                      <span class="badge yellow" title={t.motivoOverride ?? ''}>
                        Sí
                      </span>
                    ) : (
                      <span class="badge green" style="background: rgba(100,116,139,0.15); color: var(--fg-muted);">No</span>
                    )}
                  </td>
                  <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--fg-muted); font-size: 13px;">
                    {t.notas || '—'}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>

  {totalPages > 1 && (
    <div style="display: flex; justify-content: center; align-items: center; gap: 8px; padding: 16px 0;">
      {page > 1 && (
        <a href={`?${buildQueryString({ page: String(page - 1) })}`} class="secondary">
          ← Anterior
        </a>
      )}
      <span style="font-size: 13px; color: var(--fg-muted);">
        Página {page} de {totalPages} ({total} turnos)
      </span>
      {page < totalPages && (
        <a href={`?${buildQueryString({ page: String(page + 1) })}`} class="secondary">
          Siguiente →
        </a>
      )}
    </div>
  )}
</LayoutAdmin>
