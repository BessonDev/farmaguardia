---
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import AdminModal from '../../components/AdminModal.astro';
import { actions } from 'astro:actions';
import { db } from '../../db';
import { farmacias, turnos } from '../../db/schema';
import { eq, and, gt, gte, lte, asc } from 'drizzle-orm';
import { toUtcISO, nowUtc, toCaracasDateTimeLocal, formatCaracasDateTime, utcToCaracas } from '../../utils/time';

const result = Astro.getActionResult(actions.crearTurno) ?? Astro.getActionResult(actions.editarTurno) ?? Astro.getActionResult(actions.eliminarTurno) ?? Astro.getActionResult(actions.overrideTurnoHoy);
const resultImport = Astro.getActionResult(actions.importarTurnos);

const listaFarmacias = await db.select().from(farmacias).where(eq(farmacias.activa, 1)).orderBy(asc(farmacias.nombre));
const todasFarmacias = await db.select().from(farmacias).orderBy(asc(farmacias.nombre));

const ahoraISO = toUtcISO(nowUtc());

// Turnos activos ahora (para override)
const turnosActivos = await db
  .select({
    id: turnos.id,
    inicio: turnos.inicio,
    fin: turnos.fin,
    nombre: farmacias.nombre,
    farmaciaId: farmacias.id,
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(and(lte(turnos.inicio, ahoraISO), gt(turnos.fin, ahoraISO)))
  .orderBy(turnos.inicio);

// Turnos próximos 30 días
const dentroDe30Dias = new Date();
dentroDe30Dias.setUTCDate(dentroDe30Dias.getUTCDate() + 30);

const listaTurnos = await db
  .select({
    id: turnos.id,
    inicio: turnos.inicio,
    fin: turnos.fin,
    notas: turnos.notas,
    nombre: farmacias.nombre,
    sector: farmacias.sector,
    farmaciaId: farmacias.id,
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(gte(turnos.inicio, ahoraISO))
  .orderBy(asc(turnos.inicio))
  .limit(60)
  .then(rows => rows.map(t => ({ ...t, inicioLocal: toCaracasDateTimeLocal(t.inicio), finLocal: toCaracasDateTimeLocal(t.fin) })));

// Detectar si una fecha UTC cae hoy (día Caracas)
function esHoy(iso: string): boolean {
  const caracas = utcToCaracas(new Date(iso));
  const hoyCaracas = utcToCaracas(new Date());
  return (
    caracas.getUTCFullYear() === hoyCaracas.getUTCFullYear() &&
    caracas.getUTCMonth() === hoyCaracas.getUTCMonth() &&
    caracas.getUTCDate() === hoyCaracas.getUTCDate()
  );
}
---

<Layout title="Turnos - FarmaGuardia Admin" hideFooter>
  <div class="min-h-full flex">
    <AdminSidebar active="turnos" />

    <div class="flex-1 flex flex-col min-w-0">
      <div class="md:hidden flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800">
        <span class="font-bold text-gray-900 dark:text-gray-100">Turnos</span>
        <div class="flex gap-2">
          <a href="/admin" class="text-sm text-primary">Dashboard</a>
          <a href="/admin/farmacias" class="text-sm text-primary">Farmacias</a>
        </div>
      </div>

      <main class="flex-1 p-4 sm:p-6 overflow-x-clip">
        <div class="flex items-center justify-between mb-6">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Gestión de Turnos</h1>
          <div class="flex gap-2">
            <button type="button" data-open-importar class="px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors whitespace-nowrap">
              Importar
            </button>
            <button type="button" data-open-nuevo class="px-4 py-2 bg-primary hover:bg-primary-dark text-white text-sm font-medium rounded-lg transition-colors whitespace-nowrap">
              + Nuevo turno
            </button>
          </div>
        </div>

        {result?.error && (
          <div class="mb-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-sm text-red-700 dark:text-red-300">
            {result.error.message}
          </div>
        )}
        {result?.data?.ok && (
          <div class="mb-4 p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-sm text-green-700 dark:text-green-300">
            {result.data.farmaciaId ? 'Turno de emergencia asignado.' : 'Operación exitosa.'}
          </div>
        )}

        {resultImport?.error && (
          <div class="mb-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-sm text-red-700 dark:text-red-300">
            {resultImport.error.message}
          </div>
        )}
        {resultImport?.data?.ok && (
          <div class="mb-4 p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-sm text-green-700 dark:text-green-300">
            Importación completada: {resultImport.data.creados} creados, {resultImport.data.actualizados} actualizados
            {resultImport.data.errores.length > 0 && `, ${resultImport.data.omitidos} omitidos`}.
            {resultImport.data.errores.length > 0 && (
              <ul class="mt-2 list-disc list-inside">
                {resultImport.data.errores.map(e => <li class="text-xs">{e}</li>)}
              </ul>
            )}
          </div>
        )}

        <!-- Override de emergencia -->
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-4 sm:p-5 mb-8">
          <h2 class="font-semibold text-red-800 dark:text-red-300 flex items-center gap-2 mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Cambiar turno de hoy (Override de emergencia)
          </h2>
          {turnosActivos.length > 0 ? (
            <form method="POST" action={actions.overrideTurnoHoy} class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="turnoOverride" class="block text-sm font-medium text-red-800 dark:text-red-300 mb-1">Turno a sustituir</label>
                <select id="turnoOverride" name="turnoId" required class="w-full px-3 py-2 border border-red-300 dark:border-red-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
                  {turnosActivos.map(t => (
                    <option value={t.id}>
                      {t.nombre} · hasta {formatCaracasDateTime(new Date(t.fin))}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label for="farmaciaOverride" class="block text-sm font-medium text-red-800 dark:text-red-300 mb-1">Farmacia de respaldo</label>
                <select id="farmaciaOverride" name="farmaciaId" required class="w-full px-3 py-2 border border-red-300 dark:border-red-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
                  <option value="">Seleccionar...</option>
                  {todasFarmacias.filter(f => !turnosActivos.some(t => t.farmaciaId === f.id)).map(f => (
                    <option value={f.id}>{f.nombre}</option>
                  ))}
                </select>
              </div>
              <div class="sm:col-span-2">
                <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg transition-colors whitespace-nowrap">
                  Sustituir turno
                </button>
              </div>
            </form>

            <!-- Eliminar turno activo directamente -->
            <div class="mt-4 pt-4 border-t border-red-200 dark:border-red-800">
              <p class="text-sm font-medium text-red-800 dark:text-red-300 mb-2">O eliminar directamente (sin sustituir):</p>
              <div class="flex flex-col gap-2">
                {turnosActivos.map(t => (
                  <form method="POST" action={actions.eliminarTurno} onsubmit="return confirm('¿Eliminar este turno activo? La farmacia quedará sin turno.')"
                    class="flex items-center justify-between gap-3">
                    <input type="hidden" name="id" value={t.id} />
                    <span class="text-sm text-red-700 dark:text-red-400 truncate">
                      {t.nombre} · hasta {formatCaracasDateTime(new Date(t.fin))}
                    </span>
                    <button type="submit" class="px-3 py-1.5 text-xs font-medium text-red-700 dark:text-red-300 border border-red-300 dark:border-red-700 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors whitespace-nowrap">
                      Eliminar
                    </button>
                  </form>
                ))}
              </div>
            </div>
          ) : (
            <p class="text-sm text-red-700 dark:text-red-400">No hay turnos activos en este momento.</p>
          )}
        </div>

        <!-- Listado de turnos -->
        <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
          <div class="px-4 sm:px-5 py-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
            <h2 class="font-semibold text-gray-900 dark:text-gray-100">Próximos turnos (30 días)</h2>
            <span class="text-xs text-gray-500 dark:text-gray-400">{listaTurnos.length} turnos</span>
          </div>

          <!-- Cards (móvil) -->
          <div class="md:hidden divide-y divide-gray-200 dark:divide-gray-800">
            {listaTurnos.map(t => (
              <div class:list={['px-4 py-4', esHoy(t.inicio) ? 'bg-sky-50/60 dark:bg-sky-900/10' : '']}>
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="font-medium text-gray-900 dark:text-gray-100">{t.nombre}</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">{t.sector}</p>
                    {esHoy(t.inicio) && (
                      <span class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-semibold uppercase bg-sky-100 dark:bg-sky-900/40 text-sky-700 dark:text-sky-300 rounded-full mt-1">
                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Hoy
                      </span>
                    )}
                  </div>
                  <div class="flex flex-col items-end gap-1.5 text-sm">
                    <button type="button" data-editar={t.id} class="text-primary hover:underline">Editar</button>
                    <form method="POST" action={actions.eliminarTurno} onsubmit="return confirm('¿Eliminar este turno?')">
                      <input type="hidden" name="id" value={t.id} />
                      <button type="submit" class="text-red-600 dark:text-red-400 hover:underline">Eliminar</button>
                    </form>
                  </div>
                </div>
                <div class="mt-3 flex flex-col gap-1.5">
                  <span class="inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 rounded-lg w-fit">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    {formatCaracasDateTime(new Date(t.inicio))}
                  </span>
                  <span class="inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-lg w-fit">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13l-3 3m0 0l-3-3m3 3V8m0 13a9 9 0 110-18 9 9 0 010 18z" /></svg>
                    {formatCaracasDateTime(new Date(t.fin))}
                  </span>
                </div>
                {t.notas && <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{t.notas}</p>}
              </div>
            ))}
            {listaTurnos.length === 0 && (
              <div class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
                No hay turnos programados. Crea el primero con "+ Nuevo turno".
              </div>
            )}
          </div>

          <!-- Tabla (md+) -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-sm min-w-[600px]">
              <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr class="text-left text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                  <th class="px-4 py-3">Farmacia</th>
                  <th class="px-4 py-3">Inicio</th>
                  <th class="px-4 py-3">Fin</th>
                  <th class="px-4 py-3 hidden lg:table-cell">Notas</th>
                  <th class="px-4 py-3 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
                {listaTurnos.map(t => (
                  <tr class:list={['transition-colors', esHoy(t.inicio) ? 'bg-sky-50/60 dark:bg-sky-900/10' : 'hover:bg-gray-50 dark:hover:bg-gray-800/50']}>
                    <td class="px-4 py-3">
                      <p class="font-medium text-gray-900 dark:text-gray-100">{t.nombre}</p>
                      <p class="text-xs text-gray-500 dark:text-gray-400">{t.sector}</p>
                      {esHoy(t.inicio) && (
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-semibold uppercase bg-sky-100 dark:bg-sky-900/40 text-sky-700 dark:text-sky-300 rounded-full">
                          <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                          Hoy
                        </span>
                      )}
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap">
                      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 rounded-lg whitespace-nowrap">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        {formatCaracasDateTime(new Date(t.inicio))}
                      </span>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap">
                      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-lg whitespace-nowrap">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13l-3 3m0 0l-3-3m3 3V8m0 13a9 9 0 110-18 9 9 0 010 18z" /></svg>
                        {formatCaracasDateTime(new Date(t.fin))}
                      </span>
                    </td>
                    <td class="px-4 py-3 hidden lg:table-cell text-gray-500 dark:text-gray-400 max-w-[200px] truncate">{t.notas || '—'}</td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                      <button type="button" data-editar={t.id} class="text-primary hover:underline mr-3">Editar</button>
                      <form method="POST" action={actions.eliminarTurno} class="inline" onsubmit="return confirm('¿Eliminar este turno?')">
                        <input type="hidden" name="id" value={t.id} />
                        <button type="submit" class="text-red-600 dark:text-red-400 hover:underline">Eliminar</button>
                      </form>
                    </td>
                  </tr>
                ))}
                {listaTurnos.length === 0 && (
                  <tr>
                    <td colspan="5" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
                      No hay turnos programados. Crea el primero con "+ Nuevo turno".
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Modal nuevo/editar turno -->
  <AdminModal title="Turno" id="modal-turno" size="md">
    <form id="turno-form" method="POST" action="?_action=crearTurno" class="grid grid-cols-1 gap-4">
      <input type="hidden" name="id" id="t-id" />
      <div>
        <label for="t-farmaciaId" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Farmacia *</label>
        <select id="t-farmaciaId" name="farmaciaId" required class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
          <option value="">Seleccionar farmacia...</option>
          {todasFarmacias.map(f => (
            <option value={f.id}>{f.nombre}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="t-inicio" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Inicio (hora Caracas) *</label>
        <input type="datetime-local" id="t-inicio" name="inicio" required class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Ej: turno estándar 08:00</p>
      </div>
      <div>
        <label for="t-fin" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Fin (hora Caracas) *</label>
        <input type="datetime-local" id="t-fin" name="fin" required class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Ej: turno estándar 08:00 del día siguiente</p>
      </div>
      <div>
        <label for="t-notas" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Notas (opcional)</label>
        <input type="text" id="t-notas" name="notas" placeholder="Ej: Turno especial de feriado" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary-dark text-white text-sm font-medium rounded-lg transition-colors">
          Guardar
        </button>
        <button type="button" data-modal-close="modal-turno" class="px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800">
          Cancelar
        </button>
      </div>
    </form>
  </AdminModal>

  <!-- Modal importar turnos -->
  <AdminModal title="Importar turnos (Excel o CSV)" id="modal-importar" size="md">
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
      Una fila por turno. La farmacia se resuelve por su nombre exacto. Si la hora de fin es igual o anterior a la de inicio,
      el turno cruza a la mañana siguiente (ej: 08:00 a 08:00). Si un turno ya existe en ese rango, se omite salvo que marques
      "sobreescribir existentes".
    </p>
    <form method="POST" action={actions.importarTurnos} enctype="multipart/form-data" id="import-turnos-form">
      <div class="mb-4">
        <label for="archivo-turnos" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Archivo (.xlsx o .csv) *</label>
        <input
          type="file"
          id="archivo-turnos"
          name="archivo"
          accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          required
          class="block w-full text-sm text-gray-700 dark:text-gray-300 file:mr-3 file:px-4 file:py-2 file:border-0 file:rounded-lg file:bg-primary file:text-white file:text-sm file:font-medium hover:file:bg-primary-dark"
        />
        <button
          type="button"
          id="limpiar-archivo-turnos"
          class="hidden mt-2 inline-flex items-center gap-1 px-3 py-1.5 border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 text-xs font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Limpiar seleccionado
        </button>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Columnas: farmacia, fecha (AAAA-MM-DD), hora_inicio (HH:MM), hora_fin (HH:MM), notas (opcional)</p>
      </div>

      <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 mb-4 cursor-pointer">
        <input type="checkbox" name="sobreescribir" value="1" class="rounded border-gray-300 text-primary focus:ring-primary" />
        Sobre-escribir turnos existentes (mismo rango de inicio)
      </label>

      <!-- Preview en cliente -->
      <div id="preview-container" class="hidden mb-4">
        <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2 text-sm">Vista previa</h3>
        <div class="overflow-x-auto border border-gray-200 dark:border-gray-800 rounded-lg">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 dark:bg-gray-800/50">
              <tr id="preview-header" class="text-left text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide"></tr>
            </thead>
            <tbody id="preview-body" class="divide-y divide-gray-200 dark:divide-gray-800"></tbody>
          </table>
        </div>
        <p id="preview-count" class="text-xs text-gray-500 dark:text-gray-400 mt-2"></p>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary-dark text-white text-sm font-medium rounded-lg transition-colors">
          Importar turnos
        </button>
        <a href="/plantilla-turnos.xlsx" download class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Plantilla Excel
        </a>
      </div>
    </form>
  </AdminModal>

  <script is:inline define:vars={{ turnosData: listaTurnos }}>
    const form = document.getElementById('turno-form');
    const modalTitle = document.querySelector('#modal-turno h2');
    const t = {
      id: document.getElementById('t-id'),
      farmaciaId: document.getElementById('t-farmaciaId'),
      inicio: document.getElementById('t-inicio'),
      fin: document.getElementById('t-fin'),
      notas: document.getElementById('t-notas'),
    };

    function openNuevo() {
      form.reset();
      form.action = '?_action=crearTurno';
      t.id.value = '';
      if (modalTitle) modalTitle.textContent = 'Nuevo turno';
      window.FarmaGuardiaAdmin.openModal('modal-turno');
    }

    function openEditar(id) {
      const data = turnosData.find(x => x.id === id);
      if (!data) return;
      form.action = '?_action=editarTurno';
      t.id.value = data.id;
      t.farmaciaId.value = data.farmaciaId;
      t.inicio.value = data.inicioLocal;
      t.fin.value = data.finLocal;
      t.notas.value = data.notas || '';
      if (modalTitle) modalTitle.textContent = `Editar turno #${data.id}`;
      window.FarmaGuardiaAdmin.openModal('modal-turno');
    }

    document.querySelectorAll('[data-open-nuevo]').forEach(btn => btn.addEventListener('click', openNuevo));
    document.querySelectorAll('[data-editar]').forEach(btn => btn.addEventListener('click', () => openEditar(Number(btn.dataset.editar))));
    document.querySelectorAll('[data-open-importar]').forEach(btn => btn.addEventListener('click', () => window.FarmaGuardiaAdmin.openModal('modal-importar')));
  </script>

  <script>
    const archivoTurnosInput = document.getElementById('archivo-turnos');
    const limpiarArchivoTurnos = document.getElementById('limpiar-archivo-turnos');
    const previewContainer = document.getElementById('preview-container');
    const previewHeader = document.getElementById('preview-header');
    const previewBody = document.getElementById('preview-body');
    const previewCount = document.getElementById('preview-count');

    function parseCsvTurnos(text) {
      const rows = [];
      let row = [];
      let field = '';
      let inQuotes = false;
      for (let i = 0; i < text.length; i++) {
        const char = text[i];
        if (inQuotes) {
          if (char === '"') {
            if (text[i + 1] === '"') { field += '"'; i++; }
            else inQuotes = false;
          } else field += char;
        } else if (char === '"') {
          inQuotes = true;
        } else if (char === ',') {
          row.push(field); field = '';
        } else if (char === '\n' || char === '\r') {
          row.push(field); field = '';
          rows.push(row); row = [];
          if (char === '\r' && text[i + 1] === '\n') i++;
        } else {
          field += char;
        }
      }
      if (field !== '' || row.length > 0) { row.push(field); rows.push(row); }
      return rows.map(r => r.map(c => c.trim())).filter(r => r.some(c => c !== ''));
    }

    async function leerXlsxTurnos(file) {
      const { readSheet } = await import('read-excel-file/browser');
      const rows = await readSheet(file);
      return rows.map(r => r.map(c => c instanceof Date ? c.toLocaleDateString('es-VE') : (c == null ? '' : String(c))));
    }

    function mostrarPreviewTurnos(rows) {
      if (rows.length < 2) {
        previewContainer.classList.add('hidden');
        return;
      }
      previewHeader.innerHTML = rows[0].map(c => `<th class="px-3 py-2 font-medium">${c}</th>`).join('');
      previewBody.innerHTML = rows.slice(1, 11).map(r => `<tr>${r.map(c => `<td class="px-3 py-2 text-gray-600 dark:text-gray-300 whitespace-nowrap max-w-[180px] truncate">${c}</td>`).join('')}</tr>`).join('');
      previewCount.textContent = `${rows.length - 1} filas en el archivo${rows.length > 11 ? ' (mostrando las primeras 10)' : ''}.`;
      previewContainer.classList.remove('hidden');
    }

    function limpiarSeleccionTurnos() {
      archivoTurnosInput.value = '';
      previewContainer.classList.add('hidden');
      limpiarArchivoTurnos.classList.add('hidden');
      archivoTurnosInput.focus();
    }
    limpiarArchivoTurnos.addEventListener('click', limpiarSeleccionTurnos);

    archivoTurnosInput.addEventListener('change', async () => {
      const file = archivoTurnosInput.files && archivoTurnosInput.files[0];
      if (!file) {
        limpiarArchivoTurnos.classList.add('hidden');
        return;
      }
      limpiarArchivoTurnos.classList.remove('hidden');
      try {
        const esXlsx = /\.xlsx$/i.test(file.name);
        const rows = esXlsx
          ? await leerXlsxTurnos(file)
          : parseCsvTurnos(await file.text());
        mostrarPreviewTurnos(rows);
      } catch {
        previewContainer.classList.add('hidden');
      }
    });
  </script>
</Layout>
