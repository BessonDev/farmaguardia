---
import Layout from '../../layouts/Layout.astro';
import { actions } from 'astro:actions';
import { db } from '../../db';
import { farmacias, turnos } from '../../db/schema';
import { eq, and, gte, lte, asc, desc } from 'drizzle-orm';
import { toUtcISO, nowUtc, toCaracasDateTimeLocal, formatCaracasDateTime } from '../../utils/time';

const result = Astro.getActionResult(actions.crearTurno) ?? Astro.getActionResult(actions.editarTurno) ?? Astro.getActionResult(actions.eliminarTurno) ?? Astro.getActionResult(actions.overrideTurnoHoy);

const listaFarmacias = await db.select().from(farmacias).where(eq(farmacias.activa, 1)).orderBy(asc(farmacias.nombre));
const todasFarmacias = await db.select().from(farmacias).orderBy(asc(farmacias.nombre));

const ahoraISO = toUtcISO(nowUtc());

// Turno activo ahora (para override)
const turnoActivo = (await db
  .select({
    id: turnos.id,
    inicio: turnos.inicio,
    fin: turnos.fin,
    nombre: farmacias.nombre,
    farmaciaId: farmacias.id,
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(and(lte(turnos.inicio, ahoraISO), gte(turnos.fin, ahoraISO)))
  .limit(1))[0] || null;

// Turnos próximos 30 días
const dentroDe30Dias = new Date();
dentroDe30Dias.setUTCDate(dentroDe30Dias.getUTCDate() + 30);

const listaTurnos = await db
  .select({
    id: turnos.id,
    inicio: turnos.inicio,
    fin: turnos.fin,
    notas: turnos.notas,
    nombre: farmacias.nombre,
    sector: farmacias.sector,
    farmaciaId: farmacias.id,
  })
  .from(turnos)
  .innerJoin(farmacias, eq(turnos.farmaciaId, farmacias.id))
  .where(gte(turnos.inicio, ahoraISO))
  .orderBy(asc(turnos.inicio))
  .limit(60);

const url = new URL(Astro.url);
const editId = url.searchParams.get('editar');
const editando = editId ? listaTurnos.find(t => t.id === Number(editId)) : null;
---

<Layout title="Turnos - FarmaGuardia Admin">
  <div class="min-h-full flex">
    <aside class="hidden md:flex flex-col w-56 border-r border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50 shrink-0">
      <div class="p-4 border-b border-gray-200 dark:border-gray-800">
        <div class="flex items-center gap-2">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="font-bold text-gray-900 dark:text-gray-100">FarmaGuardia</span>
        </div>
        <p class="text-xs text-gray-500 mt-1">Panel de Administración</p>
      </div>
      <nav class="flex-1 p-3 space-y-1">
        <a href="/admin" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 text-sm">
          Dashboard
        </a>
        <a href="/admin/farmacias" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 text-sm">
          Farmacias
        </a>
        <a href="/admin/turnos" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-primary text-white font-medium text-sm">
          Turnos
        </a>
        <a href="/" target="_blank" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 text-sm">
          Ver landing
        </a>
      </nav>
      <div class="p-3 border-t border-gray-200 dark:border-gray-800">
        <form method="POST" action={actions.logout}>
          <button type="submit" class="w-full text-sm font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 px-3 py-2 rounded-lg">
            Cerrar sesión
          </button>
        </form>
      </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
      <div class="md:hidden flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800">
        <span class="font-bold text-gray-900 dark:text-gray-100">Turnos</span>
        <div class="flex gap-2">
          <a href="/admin" class="text-sm text-primary">Dashboard</a>
          <a href="/admin/farmacias" class="text-sm text-primary">Farmacias</a>
        </div>
      </div>

      <main class="flex-1 p-4 sm:p-6 overflow-x-clip">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Gestión de Turnos</h1>

        {result?.error && (
          <div class="mb-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-sm text-red-700 dark:text-red-300">
            {result.error.message}
          </div>
        )}
        {result?.data?.ok && (
          <div class="mb-4 p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-sm text-green-700 dark:text-green-300">
            {result.data.farmaciaId ? 'Turno de emergencia asignado.' : 'Operación exitosa.'}
          </div>
        )}

        <!-- Override de emergencia -->
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-4 sm:p-5 mb-8">
          <h2 class="font-semibold text-red-800 dark:text-red-300 flex items-center gap-2 mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Cambiar turno de hoy (Override de emergencia)
          </h2>
          {turnoActivo ? (
            <form method="POST" action={actions.overrideTurnoHoy} class="flex flex-col sm:flex-row sm:items-end gap-3">
              <div class="flex-1">
                <label for="farmaciaOverride" class="block text-sm font-medium text-red-800 dark:text-red-300 mb-1">Farmacia de respaldo</label>
                <select id="farmaciaOverride" name="farmaciaId" required class="w-full px-3 py-2 border border-red-300 dark:border-red-700 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
                  <option value="">Seleccionar...</option>
                  {todasFarmacias.filter(f => f.id !== turnoActivo.farmaciaId).map(f => (
                    <option value={f.id}>{f.nombre}</option>
                  ))}
                </select>
              </div>
              <div class="text-sm text-red-700 dark:text-red-400 pb-2 sm:pb-0 sm:mr-2">
                Turno actual: <strong>{turnoActivo.nombre}</strong>
                <br class="hidden sm:block" />
                <span class="text-xs">hasta {formatCaracasDateTime(new Date(turnoActivo.fin))}</span>
              </div>
              <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg transition-colors whitespace-nowrap">
                Sustituir turno
              </button>
            </form>
          ) : (
            <p class="text-sm text-red-700 dark:text-red-400">No hay turno activo en este momento.</p>
          )}
        </div>

        <!-- Formulario crear/editar turno -->
        <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm p-4 sm:p-6 mb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
            {editando ? `Editar turno #${editando.id}` : 'Nuevo turno'}
          </h2>
          <form method="POST" action={editando ? actions.editarTurno : actions.crearTurno} class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {editando && <input type="hidden" name="id" value={editando.id} />}
            <div class="sm:col-span-2">
              <label for="farmaciaId" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Farmacia *</label>
              <select id="farmaciaId" name="farmaciaId" required class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100">
                <option value="">Seleccionar farmacia...</option>
                {todasFarmacias.map(f => (
                  <option value={f.id} selected={editando?.farmaciaId === f.id}>{f.nombre}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="inicio" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Inicio (hora Caracas) *</label>
              <input type="datetime-local" id="inicio" name="inicio" required value={editando ? toCaracasDateTimeLocal(editando.inicio) : ''} class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Ej: turno estándar 08:00</p>
            </div>
            <div>
              <label for="fin" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Fin (hora Caracas) *</label>
              <input type="datetime-local" id="fin" name="fin" required value={editando ? toCaracasDateTimeLocal(editando.fin) : ''} class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Ej: turno estándar 08:00 del día siguiente</p>
            </div>
            <div class="sm:col-span-2">
              <label for="notas" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Notas (opcional)</label>
              <input type="text" id="notas" name="notas" value={editando?.notas ?? ''} placeholder="Ej: Turno especial de feriado" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100" />
            </div>
            <div class="sm:col-span-2 flex gap-3 pt-2">
              <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary-dark text-white text-sm font-medium rounded-lg transition-colors">
                {editando ? 'Guardar cambios' : 'Crear turno'}
              </button>
              {editando && (
                <a href="/admin/turnos" class="px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800">
                  Cancelar
                </a>
              )}
            </div>
          </form>
        </div>

        <!-- Listado de turnos -->
        <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
          <div class="px-4 sm:px-5 py-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
            <h2 class="font-semibold text-gray-900 dark:text-gray-100">Próximos turnos (30 días)</h2>
            <span class="text-xs text-gray-500 dark:text-gray-400">{listaTurnos.length} turnos</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm min-w-[600px]">
              <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr class="text-left text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                  <th class="px-4 py-3">Farmacia</th>
                  <th class="px-4 py-3">Inicio</th>
                  <th class="px-4 py-3">Fin</th>
                  <th class="px-4 py-3 hidden lg:table-cell">Notas</th>
                  <th class="px-4 py-3 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
                {listaTurnos.map(t => (
                  <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
                    <td class="px-4 py-3 font-medium text-gray-900 dark:text-gray-100">{t.nombre}</td>
                    <td class="px-4 py-3 text-gray-600 dark:text-gray-300 whitespace-nowrap">{formatCaracasDateTime(new Date(t.inicio))}</td>
                    <td class="px-4 py-3 text-gray-600 dark:text-gray-300 whitespace-nowrap">{formatCaracasDateTime(new Date(t.fin))}</td>
                    <td class="px-4 py-3 hidden lg:table-cell text-gray-500 dark:text-gray-400 max-w-[200px] truncate">{t.notas || '—'}</td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                      <a href={`/admin/turnos?editar=${t.id}`} class="text-primary hover:underline mr-3">Editar</a>
                      <form method="POST" action={actions.eliminarTurno} class="inline" onsubmit="return confirm('¿Eliminar este turno?')">
                        <input type="hidden" name="id" value={t.id} />
                        <button type="submit" class="text-red-600 dark:text-red-400 hover:underline">Eliminar</button>
                      </form>
                    </td>
                  </tr>
                ))}
                {listaTurnos.length === 0 && (
                  <tr>
                    <td colspan="5" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
                      No hay turnos programados. Crea el primero arriba.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>