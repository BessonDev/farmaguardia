---
import LayoutAdmin from '~/layouts/LayoutAdmin.astro';
import { db, schema } from '~/db/client';
import { cookies, makeCsrfToken } from '~/lib/auth';
import { desc } from 'drizzle-orm';

const farmacias = db
  .select()
  .from(schema.farmacias)
  .orderBy(desc(schema.farmacias.activa), schema.farmacias.nombre)
  .all();

const csrfToken = makeCsrfToken();
Astro.cookies.set(cookies.csrf, csrfToken, { path: '/', httpOnly: false, sameSite: 'lax', maxAge: 86400 });
---

<LayoutAdmin title="Farmacias">
  <div class="toolbar">
    <h2 style="margin: 0; flex: 1;">Farmacias</h2>
    <a href="/admin/farmacias/nueva" class="primary">+ Nueva farmacia</a>
  </div>

  <div class="card" style="padding: 0;">
    <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Sector</th>
          <th>Teléfono</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {farmacias.map((f) => (
          <tr>
              <td>
                <div style="font-weight: 600; white-space: nowrap;">{f.nombre}</div>
                <div style="font-size: 12px; color: var(--fg-muted);">{f.direccion}</div>
              </td>
            <td>{f.sector ?? '—'}</td>
            <td>{f.telefono ?? <span style="color: var(--fg-muted);">—</span>}</td>
            <td>
              {f.activa === 1 ? (
                <span class="badge green">Activa</span>
              ) : (
                <span class="badge red">Inactiva</span>
              )}
            </td>
            <td>
              <div style="display: flex; gap: 6px; justify-content: flex-end;">
                <a href={`/admin/farmacias/${f.id}`} class="secondary" style="font-size: 12px; padding: 6px 10px;">Editar</a>
                <form method="post" action={`/admin/farmacias/${f.id}/toggle`} style="display: inline;">
                  <input type="hidden" name="_csrf" value={csrfToken} />
                  <button type="submit" class="danger">
                    {f.activa === 1 ? 'Desactivar' : 'Activar'}
                  </button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>

  {farmacias.length === 0 && (
    <div class="card" style="text-align: center; color: var(--fg-muted);">
      No hay farmacias cargadas todavía.
    </div>
  )}
</LayoutAdmin>