---
import LayoutAdmin from '~/layouts/LayoutAdmin.astro';
import { cookies, makeCsrfToken } from '~/lib/auth';

const csrfToken = makeCsrfToken();
Astro.cookies.set(cookies.csrf, csrfToken, { path: '/', httpOnly: false, sameSite: 'lax', secure: import.meta.env.PROD, maxAge: 86400 });
---

<LayoutAdmin title="Nueva farmacia">
  <h2>Nueva farmacia</h2>

  <div class="card" style="max-width: 640px;">
    <form method="post" action="/admin/api/farmacias">
      <input type="hidden" name="_csrf" value={csrfToken} />

      <div class="form-grid">
        <label class="field">
          <span>Nombre *</span>
          <input name="nombre" required />
        </label>
        <label class="field">
          <span>Sector</span>
          <input name="sector" placeholder="Centro, Orinoco, etc." />
        </label>
      </div>

      <label class="field">
        <span>Dirección *</span>
        <input name="direccion" required />
      </label>

      <div class="form-grid">
        <label class="field">
          <span>Teléfono</span>
          <input name="telefono" placeholder="+582485212425" />
        </label>
        <label class="field">
          <span>WhatsApp</span>
          <input name="whatsapp" placeholder="+582485212425" />
        </label>
      </div>

      <div class="form-grid">
        <label class="field">
          <span>Latitud</span>
          <input name="latitud" type="number" step="any" placeholder="5.6635" />
        </label>
        <label class="field">
          <span>Longitud</span>
          <input name="longitud" type="number" step="any" placeholder="-67.6244" />
        </label>
      </div>

      <label class="field-check">
        <input name="delivery" type="checkbox" />
        <span>¿Cuenta con servicio de delivery?</span>
      </label>

      <div style="margin-top: 16px; display: flex; gap: 8px;">
        <button type="submit" class="primary">Crear farmacia</button>
        <a href="/admin/farmacias" class="secondary">Cancelar</a>
      </div>
    </form>
  </div>
</LayoutAdmin>