---
import ThemeToggle from '~/components/ThemeToggle.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;

const links = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/farmacias', label: 'Farmacias' },
  { href: '/admin/turnos', label: 'Turnos' },
  { href: '/admin/plantillas', label: 'Plantillas' },
  { href: '/admin/overrides', label: 'Overrides' },
  { href: '/admin/cambiar-password', label: 'Cambiar contraseña' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <script is:inline>
    (function() {
      var saved = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Admin · FarmaGuardia</title>
    <style is:global>
      :root {
        --bg: #ffffff;
        --bg-elev: #f8fafc;
        --fg: #0f172a;
        --fg-muted: #64748b;
        --border: #e2e8f0;
        --accent: #16a34a;
        --danger: #dc2626;
      }
      :root.dark {
        --bg: #0a0a0a;
        --bg-elev: #171717;
        --fg: #f5f5f5;
        --fg-muted: #a3a3a3;
        --border: #262626;
        --accent: #22c55e;
        --danger: #ef4444;
      }
      * { box-sizing: border-box; }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: var(--bg); color: var(--fg); margin: 0;
        min-height: 100dvh;
      }
      .layout {
        display: grid;
        grid-template-columns: 220px 1fr;
        min-height: 100dvh;
      }
      @media (max-width: 768px) {
        .layout { grid-template-columns: 1fr; }
        nav.sidebar { border-right: none; border-bottom: 1px solid var(--border); }
      }
      nav.sidebar {
        background: var(--bg-elev);
        border-right: 1px solid var(--border);
        padding: 20px;
      }
      nav.sidebar h1 {
        font-size: 18px; margin: 0 0 24px;
      }
      nav.sidebar h1 span { color: var(--accent); }
      nav.sidebar ul { list-style: none; padding: 0; margin: 0 0 24px; }
      nav.sidebar a {
        display: block; padding: 10px 12px; border-radius: 8px;
        color: var(--fg-muted); text-decoration: none;
        font-size: 14px; margin-bottom: 2px;
      }
      nav.sidebar a:hover { background: var(--bg); color: var(--fg); }
      nav.sidebar a.active { background: var(--bg); color: var(--fg); font-weight: 600; }
      .logout {
        display: block; padding: 10px 12px; border-radius: 8px;
        background: transparent; border: 1px solid var(--border);
        color: var(--fg-muted); cursor: pointer; font-size: 13px;
        width: 100%; text-align: left;
      }
      .logout:hover { color: var(--danger); border-color: var(--danger); }
      main.content {
        padding: 32px;
        max-width: 1100px;
      }
      main.content h2 { margin: 0 0 24px; font-size: 24px; }
      .card {
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 16px;
      }
      .card h3 { margin: 0 0 12px; font-size: 16px; }
      .row {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px; margin-bottom: 24px;
      }
      .stat {
        background: var(--bg-elev); border: 1px solid var(--border);
        border-radius: 12px; padding: 16px;
      }
      .stat .label { font-size: 12px; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.05em; }
      .stat .value { font-size: 24px; font-weight: 700; margin-top: 4px; }
      table {
        width: 100%; border-collapse: collapse; font-size: 14px;
      }
      th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); }
      th { font-size: 12px; text-transform: uppercase; color: var(--fg-muted); font-weight: 600; }
      tr:hover td { background: rgba(255, 255, 255, 0.02); }
      button.primary, a.primary {
        display: inline-block; padding: 10px 16px; border-radius: 8px;
        background: var(--accent); color: #052e16; border: none;
        font-size: 14px; font-weight: 600; cursor: pointer;
        text-decoration: none;
      }
      button.secondary, a.secondary {
        display: inline-block; padding: 8px 12px; border-radius: 8px;
        background: transparent; border: 1px solid var(--border);
        color: var(--fg); font-size: 13px; cursor: pointer;
        text-decoration: none;
      }
      button.danger {
        background: transparent; border: 1px solid var(--danger);
        color: var(--danger); padding: 6px 10px; border-radius: 6px;
        font-size: 12px; cursor: pointer;
      }
      button.danger:hover { background: var(--danger); color: white; }
      .badge {
        display: inline-block; padding: 2px 8px; border-radius: 999px;
        font-size: 11px; font-weight: 600;
      }
      .badge.green { background: rgba(34, 197, 94, 0.15); color: var(--accent); }
      .badge.red { background: rgba(239, 68, 68, 0.15); color: var(--danger); }
      .badge.yellow { background: rgba(234, 179, 8, 0.15); color: #eab308; }
      input, select, textarea {
        width: 100%; padding: 10px 12px; border-radius: 8px;
        border: 1px solid var(--border); background: var(--bg);
        color: var(--fg); font-size: 14px; font-family: inherit;
      }
      input:focus, select:focus, textarea:focus {
        outline: 2px solid var(--accent); outline-offset: 1px;
      }
      label.field { display: block; margin-bottom: 12px; }
      label.field span { display: block; font-size: 13px; color: var(--fg-muted); margin-bottom: 4px; }
      .form-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 12px;
      }
      .toolbar {
        display: flex; gap: 12px; margin-bottom: 16px;
        flex-wrap: wrap; align-items: center;
      }
    </style>
  </head>
  <body>
    <div class="layout">
      <nav class="sidebar">
        <div style="display: flex; align-items: center; gap: 8px;">
          <h1 style="flex: 1; margin: 0;"><span>Farma</span>Guardia</h1>
          <ThemeToggle />
        </div>
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.href} class={pathname === l.href || pathname.startsWith(l.href + '/') ? 'active' : ''}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
        <form method="post" action="/admin/logout">
          <button class="logout" type="submit">Cerrar sesión</button>
        </form>
      </nav>
      <main class="content">
        <slot />
      </main>
    </div>

    <script>
    (function() {
      var btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.addEventListener('click', function() {
          var html = document.documentElement;
          var isDark = html.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }
    })();
    </script>
  </body>
</html>