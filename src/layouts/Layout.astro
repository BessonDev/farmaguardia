---
// src/layouts/Layout.astro
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FarmaGuardia - Farmacias de Turno en Puerto Ayacucho</title>
    <meta name="description" content="Consulta en tiempo real cuál farmacia está de turno en Puerto Ayacucho, Estado Amazonas. Información actualizada las 24 horas." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-200">
    <script>
      // Dark mode toggle with persistence
      const html = document.documentElement;
      const storedTheme = localStorage.getItem('theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      if (storedTheme) {
        html.classList.toggle('dark', storedTheme === 'dark');
      } else {
        html.classList.toggle('dark', systemPrefersDark);
      }

      // Toggle function
      window.toggleTheme = () => {
        html.classList.toggle('dark');
        const theme = html.classList.contains('dark') ? 'dark' : 'light';
        localStorage.setItem('theme', theme);
        // Update meta theme-color for mobile browsers
        document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#000000' : '#ffffff');
      };
    </script>
    <slot />
  </body>
</html>