---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FarmaGuardia · Farmacias de turno en Puerto Ayacucho',
  description = 'Consulta en tiempo real qué farmacia está de turno hoy en Puerto Ayacucho, Estado Amazonas, Venezuela. Horarios, teléfonos, WhatsApp y mapa.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <script is:inline>
    (function() {
      var saved = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="geo.region" content="VE-X" />
    <meta name="geo.placename" content="Puerto Ayacucho, Amazonas, Venezuela" />
    <meta name="geo.position" content="5.6635;-67.6244" />
    <meta name="ICBM" content="5.6635, -67.6244" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://farmaguardia.com" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:site_name" content="FarmaGuardia" />

    <meta name="twitter:card" content="summary_large_name" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "FarmaGuardia",
      "url": "https://farmaguardia.com",
      "description": "Consulta en tiempo real qué farmacia está de turno en Puerto Ayacucho, Amazonas, Venezuela.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://farmaguardia.com",
        "query-input": "required name=search_term"
      }
    }
    </script>
  </head>
  <body>
    <slot />

    <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js');
    }
    (function() {
      var btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.addEventListener('click', function() {
          var html = document.documentElement;
          var isDark = html.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }
    })();
    </script>
  </body>
</html>
