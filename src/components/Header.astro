---
import { formatCaracasFullDate, formatCaracasTime } from '../utils/time';
---

<header class="sticky top-0 z-40 bg-white/90 dark:bg-gray-950/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <h1 class="text-xl sm:text-2xl font-black text-gray-900 dark:text-gray-100 leading-tight truncate">
          <span class="text-primary">Farma</span>Guardia
        </h1>
        <p class="text-xs text-gray-500 dark:text-gray-400 truncate">Puerto Ayacucho, Amazonas</p>
      </div>

      <button
        id="theme-toggle"
        class="p-2.5 rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors border border-gray-200 dark:border-gray-800 shrink-0"
        aria-label="Cambiar tema"
      >
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>

    <div class="mt-2 flex items-center gap-2 px-3 py-1.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg">
      <span class="relative flex w-2 h-2 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full w-2 h-2 bg-emerald-500"></span>
      </span>
      <time class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 capitalize truncate" id="current-time">
        {formatCaracasFullDate(new Date())}
      </time>
      <span class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-gray-100 tabular-nums ml-auto shrink-0" id="current-clock">
        {formatCaracasTime(new Date())}
      </span>
    </div>
  </div>
</header>

<script is:inline>
  function updateTime() {
    const dateEl = document.getElementById('current-time');
    const clockEl = document.getElementById('current-clock');
    if (dateEl || clockEl) {
      const now = new Date();
      const caracas = new Date(now.getTime() - 4 * 60 * 60 * 1000);
      if (dateEl) {
        dateEl.textContent = caracas.toLocaleDateString('es-VE', {
          weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
          timeZone: 'UTC'
        });
      }
      if (clockEl) {
        clockEl.textContent = caracas.toLocaleTimeString('es-VE', {
          hour: '2-digit', minute: '2-digit', second: '2-digit',
          hour12: false, timeZone: 'UTC'
        });
      }
    }
  }
  updateTime();
  setInterval(updateTime, 1000);
</script>
