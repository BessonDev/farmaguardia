---
interface Props {
  turnoId: number;
  farmaciaNombre: string;
}

const { turnoId, farmaciaNombre } = Astro.props;
---

<dialog id="reportar-modal" class="fixed inset-0 z-50 m-auto w-full max-w-md rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elev)] p-0 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm open:animate-scale-in" style="max-width: 480px;">
  <div class="p-6">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-bold">Reportar incidencia</h3>
      <button id="cerrar-modal" class="flex h-8 w-8 items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-sm hover:bg-[var(--color-bg-elev)]" type="button">✕</button>
    </div>

    <p class="text-sm text-[var(--color-fg-muted)] mb-5">
      ¿{farmaciaNombre} no está abierta aunque debería? Reportalo y nos encargamos.
    </p>

    <form id="reportar-form" class="space-y-4">
      <input type="hidden" name="turno_id" value={turnoId} />

      <label class="field">
        <span>¿Qué está pasando? *</span>
        <textarea name="motivo" required minlength="5" maxlength="500" rows="3" placeholder="Ej: Llegué y está cerrada, no contestan el teléfono..." class="w-full resize-none rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-3 text-sm text-[var(--color-fg)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"></textarea>
        <span class="text-xs text-[var(--color-fg-muted)] mt-1" id="char-counter">0/500</span>
      </label>

      <label class="field">
        <span>Tu contacto (opcional)</span>
        <input name="contacto" type="text" placeholder="Teléfono o email para que te avisen" class="w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-3 text-sm text-[var(--color-fg)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" />
        <span class="text-xs text-[var(--color-fg-muted)] mt-1">Así podemos contactarte si necesitamos más información.</span>
      </label>

      <div id="reportar-error" class="hidden rounded-xl bg-red-500/10 border border-red-500/30 p-3 text-sm text-red-400"></div>

      <button type="submit" id="btn-reportar" class="flex w-full items-center justify-center gap-2 rounded-xl bg-[var(--color-accent)] px-4 py-3 font-semibold text-[var(--color-accent-fg)] transition-all hover:opacity-90 disabled:opacity-50">
        <span>🚨</span>
        <span>Reportar</span>
      </button>
    </form>

    <div id="reportar-ok" class="hidden flex flex-col items-center gap-3 py-6 text-center">
      <span class="text-4xl">✅</span>
      <p class="font-semibold">Reporte enviado</p>
      <p class="text-sm text-[var(--color-fg-muted)]">Gracias por ayudar a mantener la información actualizada.</p>
      <button type="button" class="mt-2 rounded-xl border border-[var(--color-border)] px-4 py-2 text-sm hover:bg-[var(--color-bg)]" id="cerrar-ok-btn">Cerrar</button>
    </div>
  </div>
</dialog>

<script is:inline>
const modal = document.getElementById('reportar-modal');
const form = document.getElementById('reportar-form');
const btn = document.getElementById('btn-reportar');
const errorDiv = document.getElementById('reportar-error');
const okDiv = document.getElementById('reportar-ok');
const textarea = form && form.querySelector('textarea[name="motivo"]');
const counter = document.getElementById('char-counter');
const cerrarBtn = document.getElementById('cerrar-modal');
const cerrarOkBtn = document.getElementById('cerrar-ok-btn');

if (textarea && counter) {
  textarea.addEventListener('input', () => { counter.textContent = textarea.value.length + '/500'; });
}

if (cerrarBtn && modal) {
  cerrarBtn.addEventListener('click', () => modal.close());
}
if (cerrarOkBtn && modal) {
  cerrarOkBtn.addEventListener('click', () => modal.close());
}
if (modal) {
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
}

if (form && btn && errorDiv && okDiv) {
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.querySelector('span:last-child').textContent = 'Enviando...';
    errorDiv.classList.add('hidden');

    const fd = new FormData(form);

    try {
      const res = await fetch('/api/reportar', { method: 'POST', body: fd });
      const data = await res.json();

      if (!res.ok || data.error) {
        errorDiv.textContent = data.error || 'Error al enviar. Intentalo de nuevo.';
        errorDiv.classList.remove('hidden');
        btn.disabled = false;
        btn.querySelector('span:last-child').textContent = 'Reportar';
        return;
      }

      form.classList.add('hidden');
      okDiv.classList.remove('hidden');
    } catch {
      errorDiv.textContent = 'Error de conexión. Verificá tu internet.';
      errorDiv.classList.remove('hidden');
      btn.disabled = false;
      btn.querySelector('span:last-child').textContent = 'Reportar';
    }
  });
}
</script>
