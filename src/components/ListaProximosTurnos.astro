---
// src/components/ListaProximosTurnos.astro
export interface Props {
  turnos: Array<{
    farmacia: {
      id: number;
      nombre: string;
      direccion: string;
      sector: string;
      telefono: string | null;
      whatsapp: string | null;
      latitud: number | null;
      longitud: number | null;
      imagenUrl: string | null;
      activa: number;
      delivery: number;
    };
    turno: {
      id: number;
      farmaciaId: number;
      inicio: Date;
      fin: Date;
      notas: string | null;
    };
  }>;
}
const { turnos } = Astro.props;

// Format date and time for display
const formatDateTime = (date: Date) => {
  return new Intl.DateTimeFormat('es-VE', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  }).format(date);
};
---
<section>
  {turnos.length > 0 ? (
    <div class="space-y-4">
      {turnos.map((item, index) => (
        <div key={index} class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
          <div class="px-6 py-4">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
              <div class="flex-1">
                <h3 class="font-medium text-gray-900 dark:text-gray-100">
                  {item.farmacia.nombre}
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  {item.farmacia.direccion}
                </p>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  Sector: {item.farmacia.sector}
                </p>
                {item.farmacia.delivery && (
                  <span class="inline-flex items-center px-2 py-0.5 bg-green-100 text-green-800 text-xs font-semibold rounded-full mt-1">
                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Delivery
                  </span>
                )}
              </div>
              <div class="text-right space-y-1">
                <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
                  Desde {formatDateTime(item.turno.inicio)}
                </p>
                <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
                  Hasta {formatDateTime(item.turno.fin)}
                </p>
                {item.turno.notas && (
                  <p class="mt-1 text-xs text-gray-500 dark:text-gray-400 italic">
                    {item.turno.notas}
                  </p>
                )}
              </div>
            </div>
          </div>
          {item.farmacia.latitud && item.farmacia.longitud && (
            <div class="px-6 py-3 bg-gray-50 dark:bg-gray-700 text-center">
              <a 
                href={`https://www.google.com/maps/search/?api=1&query=${item.farmacia.latitud},${item.farmacia.longitud}`} 
                target="_blank"
                rel="noopener noreferrer"
                class="text-indigo-600 hover:text-indigo-800 underline"
              >
                Ver en Google Maps
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  ) : (
    <div class="text-center py-8">
      <p class="text-gray-500 dark:text-gray-400">
        No hay turnos programados para los próximos días.
      </p>
    </div>
  )}
</section>