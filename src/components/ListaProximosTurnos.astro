---
import { formatCaracasDateTime, formatCaracasDate } from '../utils/time';

interface Props {
  turnos: Array<{
    farmacia: {
      id: number;
      nombre: string;
      direccion: string;
      telefono?: string;
      whatsapp?: string;
      latitud?: number;
      longitud?: number;
      delivery?: boolean;
      sector?: string;
    };
    inicio: string;
    fin: string;
  }>;
}
const { turnos } = Astro.props;
---

<div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm overflow-hidden">
  <div class="px-4 sm:px-5 py-4 border-b border-gray-200 dark:border-gray-800">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 flex items-center gap-2">
      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Próximos turnos (7 días)
    </h2>
  </div>

  <div class="divide-y divide-gray-200 dark:divide-gray-800">
    {turnos.map((turno, index) => (
      <div class="px-4 sm:px-5 py-3 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium bg-primary/10 text-primary rounded-full">
                {formatCaracasDate(new Date(turno.inicio))}
              </span>
              <h3 class="font-medium text-gray-900 dark:text-gray-100 truncate">
                {turno.farmacia.nombre}
              </h3>
            </div>
            <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {turno.farmacia.direccion}
              </span>
              {turno.farmacia.sector && (
                <span class="px-1.5 py-0.5 text-xs bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded">
                  {turno.farmacia.sector}
                </span>
              )}
              {turno.farmacia.delivery && (
                <span class="px-1.5 py-0.5 text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded">
                  🚚 Delivery
                </span>
              )}
            </div>
          </div>
          <div class="flex items-center gap-2 text-right sm:flex-col sm:items-end w-full sm:w-auto">
            <span class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap">
              {formatCaracasTime(new Date(turno.inicio))} – {formatCaracasTime(new Date(turno.fin))}
            </span>
          </div>
        </div>
      </div>
    ))}
  </div>

  {turnos.length === 0 && (
    <div class="p-8 text-center">
      <svg class="w-12 h-12 mx-auto text-gray-300 dark:text-gray-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <p class="text-gray-500 dark:text-gray-400">No hay turnos programados para los próximos 7 días</p>
    </div>
  )}
</div>