---
import { formatCaracasDate, formatCaracasTime } from '../utils/time';

interface Props {
  turnos: Array<{
    id: number;
    farmacia: {
      id: number;
      nombre: string;
      direccion: string;
      telefono?: string;
      whatsapp?: string;
      latitud?: number;
      longitud?: number;
      imagenUrl?: string;
      delivery?: boolean;
      sector?: string;
    };
    inicio: string;
    fin: string;
  }>;
}
const { turnos } = Astro.props;

function telUrl(telefono?: string) {
  return telefono ? `tel:+58${telefono.replace(/\D/g, '')}` : null;
}

function whatsappUrl(whatsapp?: string, nombre?: string) {
  return whatsapp
    ? `https://wa.me/58${whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(`Hola ${nombre ?? ''}, consulta desde FarmaGuardia: ¿están de turno hoy?`)}`
    : null;
}

function mapsUrl(farmacia: Props['turnos'][number]['farmacia']) {
  return farmacia.latitud && farmacia.longitud
    ? `https://www.google.com/maps/search/?api=1&query=${farmacia.latitud},${farmacia.longitud}`
    : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(farmacia.direccion + ', Puerto Ayacucho, Amazonas')}`;
}
---

<div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm overflow-hidden">
  <div class="px-5 sm:px-6 py-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 flex items-center gap-2">
      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Próximos turnos
    </h2>
    <span class="text-xs text-gray-500 dark:text-gray-400">Próximos 7 días</span>
  </div>

  <ul class="divide-y divide-gray-100 dark:divide-gray-800">
    {turnos.map((turno) => (
      <li>
        <details class="group">
          <summary class="flex items-center gap-3 sm:gap-4 px-4 sm:px-6 py-4 cursor-pointer select-none list-none hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors [&::-webkit-details-marker]:hidden">
            <div class="w-12 h-12 rounded-xl shrink-0 overflow-hidden bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
              {turno.farmacia.imagenUrl ? (
                <img
                  src={turno.farmacia.imagenUrl}
                  alt={`Farmacia ${turno.farmacia.nombre}`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              ) : (
                <svg class="w-6 h-6 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <h3 class="font-medium text-gray-900 dark:text-gray-100 truncate">
                  {turno.farmacia.nombre}
                </h3>
                {turno.farmacia.delivery && (
                  <span class="inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded-full shrink-0">
                    Delivery
                  </span>
                )}
              </div>
              <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 truncate">
                {formatCaracasDate(new Date(turno.inicio))} · {formatCaracasTime(new Date(turno.inicio))} – {formatCaracasTime(new Date(turno.fin))}
              </p>
            </div>

            <svg class="w-5 h-5 shrink-0 text-gray-400 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>

          <div class="px-4 sm:px-6 pb-5 pt-1 border-t border-gray-100 dark:border-gray-800 bg-gray-50/60 dark:bg-gray-800/30">
            <div class="flex items-start gap-1.5 text-sm text-gray-600 dark:text-gray-400 mb-4">
              <svg class="w-4 h-4 shrink-0 mt-0.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>{turno.farmacia.direccion}</span>
            </div>

            <div class="flex flex-wrap gap-2">
              {telUrl(turno.farmacia.telefono) && (
                <a href={telUrl(turno.farmacia.telefono)} class="flex items-center justify-center gap-2 px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  Llamar
                </a>
              )}
              {whatsappUrl(turno.farmacia.whatsapp, turno.farmacia.nombre) && (
                <a href={whatsappUrl(turno.farmacia.whatsapp, turno.farmacia.nombre)} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-3.5 py-2 bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-semibold rounded-xl transition-colors">
                  <span class="flex items-center justify-center bg-white rounded-full w-5 h-5 shrink-0">
                    <svg class="w-[13px] h-[15px]" viewBox="0 0 448 512" fill="#25D366" fill-rule="evenodd" aria-hidden="true">
                      <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.5c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
                    </svg>
                  </span>
                  WhatsApp
                </a>
              )}
              <a href={mapsUrl(turno.farmacia)} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-3.5 py-2 bg-primary hover:bg-primary-dark text-white text-sm font-semibold rounded-xl transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Cómo llegar
              </a>
            </div>
          </div>
        </details>
      </li>
    ))}
  </ul>

  {turnos.length === 0 && (
    <div class="p-10 text-center">
      <svg class="w-12 h-12 mx-auto text-gray-300 dark:text-gray-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <p class="text-gray-500 dark:text-gray-400">No hay turnos programados para los próximos 7 días</p>
    </div>
  )}
</div>
