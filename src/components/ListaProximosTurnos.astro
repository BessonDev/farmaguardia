---
import { formatCaracasDate, formatCaracasTime } from '../utils/time';

interface Props {
  turnos: Array<{
    id: number;
    farmacia: {
      id: number;
      nombre: string;
      direccion: string;
      telefono?: string;
      whatsapp?: string;
      latitud?: number;
      longitud?: number;
      imagenUrl?: string;
      delivery?: boolean;
      sector?: string;
    };
    inicio: string;
    fin: string;
  }>;
}
const { turnos } = Astro.props;
---

<div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm overflow-hidden">
  <div class="px-5 sm:px-6 py-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 flex items-center gap-2">
      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Próximos turnos
    </h2>
    <span class="text-xs text-gray-500 dark:text-gray-400">Próximos 7 días</span>
  </div>

  <ul class="divide-y divide-gray-100 dark:divide-gray-800">
    {turnos.map((turno) => (
      <li class="px-5 sm:px-6 py-4 flex items-center gap-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
        <div class="w-12 h-12 rounded-xl shrink-0 overflow-hidden bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
          {turno.farmacia.imagenUrl ? (
            <img
              src={turno.farmacia.imagenUrl}
              alt={`Farmacia ${turno.farmacia.nombre}`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          ) : (
            <svg class="w-6 h-6 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          )}
        </div>

        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <h3 class="font-medium text-gray-900 dark:text-gray-100 truncate">
              {turno.farmacia.nombre}
            </h3>
            {turno.farmacia.delivery && (
              <span class="inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded-full shrink-0">
                Delivery
              </span>
            )}
          </div>
          <div class="flex items-start gap-1 text-sm text-gray-500 dark:text-gray-400">
            <svg class="w-3.5 h-3.5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="truncate">{turno.farmacia.direccion}</span>
          </div>
        </div>

        <div class="text-right shrink-0">
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100">
            {formatCaracasDate(new Date(turno.inicio))}
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400 tabular-nums">
            {formatCaracasTime(new Date(turno.inicio))} – {formatCaracasTime(new Date(turno.fin))}
          </p>
        </div>
      </li>
    ))}
  </ul>

  {turnos.length === 0 && (
    <div class="p-10 text-center">
      <svg class="w-12 h-12 mx-auto text-gray-300 dark:text-gray-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <p class="text-gray-500 dark:text-gray-400">No hay turnos programados para los próximos 7 días</p>
    </div>
  )}
</div>
