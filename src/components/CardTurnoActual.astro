---
// src/components/CardTurnoActual.astro
export interface Props {
  farmacia: {
    id: number;
    nombre: string;
    direccion: string;
    sector: string;
    telefono: string | null;
    whatsapp: string | null;
    latitud: number | null;
    longitud: number | null;
    imagenUrl: string | null;
    activa: number;
    delivery: number;
  };
  turno: {
    id: number;
    farmaciaId: number;
    inicio: Date;
    fin: Date;
    notas: string | null;
  };
  ahora: Date;
}
const { farmacia, turno, ahora } = Astro.props;

// Function to check if the pharmacy is open right now (within the turno)
const isOpenNow = (ahora: Date, inicio: Date, fin: Date) => {
  return ahora >= inicio && ahora <= fin;
};

// Format date and time for display
const formatDateTime = (date: Date) => {
  return new Intl.DateTimeFormat('es-VE', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  }).format(date);
};
---
<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
  <div class="p-6">
    <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
      {farmacia.imagenUrl && (
        <img 
          src={farmacia.imagenUrl} 
          alt={`Logo de ${farmacia.nombre}`} 
          class="w-24 h-24 object-cover rounded-md shadow-sm"
        />
      )}
      <div class="flex-1">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
          {farmacia.nombre}
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-2">
          {farmacia.direccion}
        </p>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Sector: {farmacia.sector}
        </p>
        <div class="flex flex-wrap gap-4 mb-4">
          {farmacia.telefono && (
            <a 
              href={`tel:${farmacia.telefono}`} 
              class="flex items-center bg-indigo-100 text-indigo-800 px-3 py-1 rounded text-sm hover:bg-indigo-200 dark:bg-indigo-200 dark:text-indigo-100 dark:hover:bg-indigo-300"
            >
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516-5.517l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"></path>
              </svg>
              Llamar
            </a>
          )}
          {farmacia.whatsapp && (
            <a 
              href={`https://wa.me/${farmacia.whatsapp.replace(/\D/g, '')}`} 
              class="flex items-center bg-green-100 text-green-800 px-3 py-1 rounded text-sm hover:bg-green-200 dark:bg-green-200 dark:text-green-100 dark:hover:bg-green-300"
            >
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
              </svg>
              WhatsApp
            </a>
          )}
          {farmacia.latitud && farmacia.longitud && (
            <a 
              href={`https://www.google.com/maps/search/?api=1&query=${farmacia.latitud},${farmacia.longitud}`} 
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center bg-blue-100 text-blue-800 px-3 py-1 rounded text-sm hover:bg-blue-200 dark:bg-blue-200 dark:text-blue-100 dark:hover:bg-blue-300"
            >
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-2.21 0-4 1.79-4 4 0 .526.135 1.034.369 1.486L5 18l3.364-1.036a4.001 4.001 0 014.266-2.808L12 14l2.288-1.146a4.001 4.001 0 014.266 2.808l3.364 1.036-3.5-1.15c-.234-.452-.369-.96-.369-1.486 0-2.21-1.79-4-4-4zm0 9a2 2 0 110-4 2 2 0 010 4z"></path>
              </svg>
              Ver en mapa
            </a>
          )}
        </div>
        {farmacia.delivery && (
          <span class="inline-flex items-center px-3 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Delivery disponible
          </span>
        )}
      </div>
    </div>

    <div class="mt-6 p-4 bg-indigo-50 dark:bg-indigo-900/20 rounded-lg">
      <div class="flex items-start space-x-3">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-indigo-600" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zm-1 9a1 1 0 10-2 0v3h2v-3zm4-13a1 1 0 00-2 0v5H9a1 1 0 000 2h2v2a1 1 0 002 0v-2h2a1 1 0 000-2h2V5a1 1 0 00-2-0z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <p class="text-sm text-indigo-600 dark:text-indigo-400 font-medium">
            Horario de turno
          </p>
          <p class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">
            Desde {formatDateTime(turno.inicio)} hasta {formatDateTime(turno.fin)}
          </p>
          {turno.notas && (
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 italic">
              {turno.notas}
            </p>
          )}
        </div>
      </div>
    </div>
  </div>
</div>