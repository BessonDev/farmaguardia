---
import { formatCaracasDateTime } from '../utils/time';

interface Props {
  farmacia: {
    id: number;
    nombre: string;
    direccion: string;
    telefono?: string;
    whatsapp?: string;
    latitud?: number;
    longitud?: number;
    imagenUrl?: string;
    sector?: string;
    delivery?: boolean;
  };
  turnoId?: number;
  finTurno: string;
  isCurrent: boolean;
}
const { farmacia, turnoId, finTurno, isCurrent } = Astro.props;

const tieneCoordenadas = typeof farmacia.latitud === 'number' && typeof farmacia.longitud === 'number';

const mapsUrl = tieneCoordenadas
  ? `https://www.google.com/maps/search/?api=1&query=${farmacia.latitud},${farmacia.longitud}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(farmacia.direccion + ', Puerto Ayacucho, Amazonas')}`;

const whatsappUrl = farmacia.whatsapp
  ? `https://wa.me/58${farmacia.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(`Hola, consulta desde FarmaGuardia: ¿están de turno hoy?`)}`
  : null;

const telUrl = farmacia.telefono
  ? `tel:+58${farmacia.telefono.replace(/\D/g, '')}`
  : null;

// Mapa embebido OpenStreetMap (sin API key)
const mapEmbedUrl = tieneCoordenadas
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${farmacia.longitud! - 0.004}%2C${farmacia.latitud! - 0.004}%2C${farmacia.longitud! + 0.004}%2C${farmacia.latitud! + 0.004}&layer=mapnik&marker=${farmacia.latitud}%2C${farmacia.longitud}`
  : null;
---

<div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm overflow-hidden {isCurrent ? 'ring-2 ring-primary/60 shadow-lg shadow-primary/5' : ''}">
  <!-- Foto / banner -->
  <div class="relative h-44 sm:h-56 overflow-hidden bg-gradient-to-br from-primary/80 via-primary to-primary-dark">
    {farmacia.imagenUrl ? (
      <img
        src={farmacia.imagenUrl}
        alt={`Farmacia ${farmacia.nombre}`}
        class="w-full h-full object-cover"
        loading="eager"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <svg class="w-20 h-20 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>
    )}
    {isCurrent && (
      <div class="absolute top-3 left-3">
        <span class="inline-flex items-center gap-1.5 bg-emerald-500 text-white px-3 py-1.5 rounded-full text-xs sm:text-sm font-semibold shadow-lg">
          <span class="relative flex w-2 h-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex rounded-full w-2 h-2 bg-white"></span>
          </span>
          Abierto ahora
        </span>
      </div>
    )}
  </div>

  <!-- Contenido -->
  <div class="p-5 sm:p-6">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div class="flex-1 min-w-0">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">
          {farmacia.nombre}
        </h2>

        <div class="flex items-start gap-2 text-gray-600 dark:text-gray-300 text-sm mt-2">
          <svg class="w-4 h-4 shrink-0 mt-0.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{farmacia.direccion}</span>
        </div>

        <div class="flex flex-wrap gap-2 mt-3">
          {farmacia.sector && (
            <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full">
              {farmacia.sector}
            </span>
          )}
          {farmacia.delivery && (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded-full">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a2 2 0 11-4 0m4 0a2 2 0 10-4 0" />
              </svg>
              Delivery
            </span>
          )}
        </div>
      </div>

      <div class="flex flex-col gap-2 w-full sm:w-44 sm:flex-shrink-0">
        {telUrl && (
          <a href={telUrl} class="flex items-center justify-center gap-2 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl transition-colors focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Llamar
          </a>
        )}
        {whatsappUrl && (
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-4 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-xl transition-colors focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
            <svg class="w-[18px] h-[20px]" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
              <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.5c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
            </svg>
            WhatsApp
          </a>
        )}
      </div>
    </div>

    <!-- Turno info -->
    <div class="mt-5 pt-4 border-t border-gray-100 dark:border-gray-800 flex flex-wrap items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Turno hasta: <strong class="text-gray-900 dark:text-gray-100 font-semibold">{formatCaracasDateTime(new Date(finTurno))}</strong>
      </span>
    </div>
  </div>

  <!-- Mapa -->
  <div class="px-5 sm:px-6 pb-5 sm:pb-6">
    <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-4 py-2.5 bg-primary hover:bg-primary-dark text-white font-semibold rounded-xl transition-colors focus:ring-2 focus:ring-primary focus:ring-offset-2 dark:focus:ring-offset-gray-900 mb-3">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      Cómo llegar
    </a>
    {mapEmbedUrl && (
      <div class="relative overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
        <iframe
          title={`Mapa de ${farmacia.nombre}`}
          src={mapEmbedUrl}
          class="w-full h-40 block map-dark"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    )}
  </div>

  {isCurrent && (
    <div class="px-5 sm:px-6 pb-5 sm:pb-6 border-t border-gray-100 dark:border-gray-800">
      <button
        type="button"
        onclick={`window.FarmaGuardia?.openReportModal(${farmacia.id}, ${turnoId ?? 'null'})`}
        class="w-full flex items-center justify-center gap-2 px-4 py-3 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 font-semibold rounded-xl transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        Reportar farmacia
      </button>
    </div>
  )}
</div>
