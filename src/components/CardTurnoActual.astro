---
import { formatCaracasDateTime, formatCaracasDate } from '../utils/time';

interface Props {
  farmacia: {
    id: number;
    nombre: string;
    direccion: string;
    telefono?: string;
    whatsapp?: string;
    latitud?: number;
    longitud?: number;
    delivery?: boolean;
  };
  finTurno: string;
  isCurrent: boolean;
}
const { farmacia, finTurno, isCurrent } = Astro.props;

const mapsUrl = farmacia.latitud && farmacia.longitud
  ? `https://www.google.com/maps/search/?api=1&query=${farmacia.latitud},${farmacia.longitud}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(farmacia.direccion + ', Puerto Ayacucho, Amazonas')}`;

const whatsappUrl = farmacia.whatsapp
  ? `https://wa.me/58${farmacia.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(`Hola, consulta desde FarmaGuardia: ¿están de turno hoy?`)}`
  : null;

const telUrl = farmacia.telefono
  ? `tel:+58${farmacia.telefono.replace(/\D/g, '')}`
  : null;
---

<div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm overflow-hidden {isCurrent ? 'ring-2 ring-primary' : ''}">
  <div class="p-4 sm:p-5">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-2">
          <h2 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100 truncate">
            {farmacia.nombre}
          </h2>
          {isCurrent && (
            <span class="inline-flex items-center gap-1.5 bg-primary text-white px-3 py-1 rounded-full text-sm font-medium animate-pulse-slow shrink-0">
              <span class="w-2 h-2 bg-white rounded-full"></span>
              ABIERTO AHORA
            </span>
          )}
        </div>
        
        <div class="flex flex-wrap items-center gap-2 text-gray-600 dark:text-gray-300 text-sm mb-3">
          <svg class="w-4 h-4 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="truncate">{farmacia.direccion}</span>
        </div>

        {farmacia.sector && (
          <span class="inline-block px-2 py-0.5 text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full mb-2">
            {farmacia.sector}
          </span>
        )}

        {farmacia.delivery && (
          <span class="inline-block px-2 py-0.5 text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded-full mb-2">
            🚚 Delivery disponible
          </span>
        )}
      </div>

      <div class="flex flex-col gap-2 w-full sm:w-auto sm:flex-shrink-0">
        {telUrl && (
          <a href={telUrl} class="flex items-center justify-center gap-2 px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors focus:ring-2 focus:ring-green-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Llamar</span>
          </a>
        )}
        {whatsappUrl && (
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-4 py-2.5 bg-green-500 hover:bg-green-600 text-white font-medium rounded-lg transition-colors focus:ring-2 focus:ring-green-400 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.4c-1.193-.96-1.989-2.873-1.989-4.588 0-2.317 1.779-4.2 3.976-4.2 2.196 0 3.977 1.882 3.977 4.2 0 1.706-.796 3.615-1.988 4.588-1.194.961-4.43 2.512-7.965 2.512-3.533 0-6.77-1.55-7.964-2.512z" />
            </svg>
            <span>WhatsApp</span>
          </a>
        )}
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 px-4 py-2.5 bg-primary hover:bg-primary-dark text-white font-medium rounded-lg transition-colors focus:ring-2 focus:ring-primary focus:ring-offset-2 dark:focus:ring-offset-gray-900">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Cómo llegar</span>
        </a>
      </div>
    </div>

    <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-800 flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Turno hasta: <strong class="text-gray-900 dark:text-gray-100">{formatCaracasDateTime(new Date(finTurno))}</strong>
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Fecha: <strong class="text-gray-900 dark:text-gray-100">{formatCaracasDate(new Date(finTurno))}</strong>
      </span>
    </div>
  </div>
</div>