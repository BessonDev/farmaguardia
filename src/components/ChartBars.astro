---
interface Bar {
  label: string;
  value: number;
}

interface Props {
  data: Bar[];
  title: string;
  max?: number;
}

const { data, title, max } = Astro.props;
const maxVal = max ?? Math.max(...data.map((d) => d.value), 1);
---

<div class="chart-card">
  <h3 class="chart-title">{title}</h3>

  {data.length === 0 ? (
    <p class="chart-empty">Sin datos en el período seleccionado.</p>
  ) : (
    <div class="chart-grid">
      {data.map((bar) => {
        const pct = Math.round((bar.value / maxVal) * 100);
        return (
          <div class="chart-col" title={`${bar.label}: ${bar.value} turnos`}>
            <div class="chart-bar-wrap">
              <div class="chart-bar" style={`--bar-h: ${pct}%`}></div>
            </div>
            <span class="chart-label">{bar.label}</span>
          </div>
        );
      })}
    </div>
  )}
</div>

<style is:global>
  .chart-card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 16px;
  }
  .chart-title {
    margin: 0 0 16px;
    font-size: 16px;
  }
  .chart-empty {
    margin: 0;
    color: var(--fg-muted);
    font-size: 14px;
  }
  .chart-grid {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    min-height: 200px;
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .chart-col {
    flex: 1 1 0;
    min-width: 40px;
    max-width: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .chart-bar-wrap {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .chart-bar {
    width: 100%;
    max-width: 48px;
    height: var(--bar-h);
    min-height: 4px;
    border-radius: 6px 6px 2px 2px;
    background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 60%, transparent));
    transition: height 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: bar-grow 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .chart-label {
    font-size: 11px;
    color: var(--fg-muted);
    text-align: center;
    line-height: 1.2;
    word-break: break-word;
    hyphens: auto;
    max-width: 100%;
  }
  @keyframes bar-grow {
    from { height: 0; }
    to { height: var(--bar-h); }
  }
</style>
