---
import type { TurnoActivo } from '../lib/turno-actual';
import { formatHoraCaracas } from '../lib/tz';

interface Props {
  turno: TurnoActivo;
}

const { turno } = Astro.props;
const { farmacia, finUtc, enOverride, motivoOverride } = turno;

const telHref = farmacia.telefono ? `tel:${farmacia.telefono.replace(/[^\d+]/g, '')}` : null;
const waHref = farmacia.whatsapp
  ? `https://wa.me/${farmacia.whatsapp.replace(/[^\d]/g, '')}?text=${encodeURIComponent('Hola, vi que están de turno en FarmaGuardia.')}`
  : null;
const mapsHref = (() => {
  if (farmacia.latitud !== null && farmacia.longitud !== null) {
    return `https://www.google.com/maps/search/?api=1&query=${farmacia.latitud},${farmacia.longitud}`;
  }
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(farmacia.direccion)}`;
})();

const tieneCoords = farmacia.latitud !== null && farmacia.longitud !== null;

const mapaEmbedUrl = tieneCoords
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${farmacia.longitud! - 0.008},${farmacia.latitud! - 0.008},${farmacia.longitud! + 0.008},${farmacia.latitud! + 0.008}&layer=mapnik&marker=${farmacia.latitud},${farmacia.longitud}`
  : null;
---

<article class="animate-fade-in rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elev)] p-6 shadow-lg shadow-black/10 transition-shadow duration-300 hover:shadow-xl hover:shadow-black/20">
  {enOverride && (
    <div class="animate-scale-in mb-4 rounded-lg bg-yellow-500/10 border border-yellow-500/30 px-4 py-3 text-sm text-yellow-600 dark:text-yellow-400 flex items-center gap-2">
      <span>⚠️</span>
      <span>Turno modificado{motivoOverride ? `: ${motivoOverride}` : ''}</span>
    </div>
  )}

  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-tight text-[var(--color-fg)]">{farmacia.nombre}</h2>
      {farmacia.sector && (
        <p class="mt-1 text-sm text-[var(--color-fg-muted)]">
          <span class="inline-block rounded-full bg-[var(--color-accent)]/10 px-2.5 py-0.5 text-xs font-medium text-[var(--color-accent)]">
            {farmacia.sector}
          </span>
        </p>
      )}
    </div>
    <span class="shrink-0 inline-flex items-center gap-1.5 rounded-full bg-green-500/15 px-3.5 py-1.5 text-xs font-semibold text-green-600 dark:text-green-400 border border-green-500/20">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-500"></span>
      </span>
      ABIERTO
    </span>
  </div>

  <div class="mt-5 space-y-3 text-sm">
    <div class="flex items-start gap-3">
      <span class="mt-0.5 shrink-0 text-base">📍</span>
      <div>
        <span class="text-[var(--color-fg)]">{farmacia.direccion}</span>
        <a href={mapsHref} target="_blank" rel="noopener" class="block text-xs text-[var(--color-accent)] hover:underline mt-0.5">
          Ver en Google Maps →
        </a>
      </div>
    </div>
    <div class="flex items-center gap-3 text-[var(--color-fg-muted)]">
      <span class="shrink-0 text-base">⏰</span>
      <span>Atención hasta las <strong class="text-[var(--color-fg)]">{formatHoraCaracas(finUtc)}</strong></span>
    </div>
  </div>

  {mapaEmbedUrl && (
    <div class="map-container mt-5 animate-fade-in-up stagger-2">
      <iframe
        src={mapaEmbedUrl}
        loading="lazy"
        title="Mapa de ubicación"
        class="w-full rounded-xl border border-[var(--color-border)]"
        style="height: 200px;"
      ></iframe>
    </div>
  )}

  <div class="mt-5 grid grid-cols-1 gap-3">
    {telHref && (
      <a
        href={telHref}
        class="animate-fade-in-up stagger-3 flex items-center justify-center gap-2.5 rounded-xl bg-[var(--color-accent)] px-4 py-3.5 font-semibold text-[var(--color-accent-fg)] transition-all duration-200 hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-[var(--color-accent)]/20"
      >
        <span class="text-lg">📞</span>
        <span>Llamar{farmacia.telefono ? ` (${farmacia.telefono})` : ''}</span>
      </a>
    )}
    <div class="grid grid-cols-2 gap-3">
      {waHref && (
        <a
          href={waHref}
          target="_blank" rel="noopener"
          class="animate-fade-in-up stagger-4 flex items-center justify-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm font-medium transition-all duration-200 hover:bg-[var(--color-bg-elev)] hover:border-[#25D366] hover:text-[#25D366] hover:shadow-lg hover:shadow-black/10"
        >
          <span class="text-lg">💬</span>
          <span>WhatsApp</span>
        </a>
      )}
      <a
        href={mapsHref}
        target="_blank" rel="noopener"
        class="animate-fade-in-up stagger-5 flex items-center justify-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm font-medium transition-all duration-200 hover:bg-[var(--color-bg-elev)] hover:text-[var(--color-accent)] hover:shadow-lg hover:shadow-black/10"
      >
        <span class="text-lg">🗺️</span>
        <span>Ubicación</span>
      </a>
    </div>
  </div>
</article>
