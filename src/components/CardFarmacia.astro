---
import type { TurnoActivo } from '../lib/turno-actual';
import { formatHoraCaracas } from '../lib/tz';

interface Props {
  turno: TurnoActivo;
}

const { turno } = Astro.props;
const { farmacia, finUtc, enOverride, motivoOverride } = turno;

const telHref = farmacia.telefono ? `tel:${farmacia.telefono.replace(/[^\d+]/g, '')}` : null;
const waHref = farmacia.whatsapp
  ? `https://wa.me/${farmacia.whatsapp.replace(/[^\d]/g, '')}?text=${encodeURIComponent('Hola, vi que están de turno en FarmaGuardia.')}`
  : null;
const mapsHref = (() => {
  if (farmacia.latitud !== null && farmacia.longitud !== null) {
    return `https://www.google.com/maps/search/?api=1&query=${farmacia.latitud},${farmacia.longitud}`;
  }
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(farmacia.direccion)}`;
})();
---

<article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elev)] p-6 shadow-lg">
  {enOverride && (
    <div class="mb-4 rounded-lg bg-yellow-500/10 border border-yellow-500/30 px-4 py-2 text-sm text-yellow-600 dark:text-yellow-400">
      ⚠️ Turno modificado{motivoOverride ? `: ${motivoOverride}` : ''}
    </div>
  )}

  <div class="flex items-start justify-between gap-3">
    <div>
      <h2 class="text-2xl font-bold leading-tight">{farmacia.nombre}</h2>
      {farmacia.sector && (
        <p class="mt-1 text-sm text-[var(--color-fg-muted)]">{farmacia.sector}</p>
      )}
    </div>
    <span class="shrink-0 inline-flex items-center gap-1.5 rounded-full bg-green-500/15 px-3 py-1 text-xs font-semibold text-green-600 dark:text-green-400">
      <span class="h-2 w-2 rounded-full bg-green-500 animate-pulse-badge"></span>
      ABIERTO
    </span>
  </div>

  <div class="mt-5 space-y-2 text-sm">
    <p class="flex gap-2">
      <span aria-hidden="true">📍</span>
      <span>{farmacia.direccion}</span>
    </p>
    <p class="flex gap-2 text-[var(--color-fg-muted)]">
      <span aria-hidden="true">⏰</span>
      <span>Hasta las {formatHoraCaracas(finUtc)}</span>
    </p>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-2">
    {telHref && (
      <a href={telHref} class="flex items-center justify-center gap-2 rounded-xl bg-[var(--color-accent)] px-4 py-3 font-semibold text-[var(--color-accent-fg)] transition-opacity hover:opacity-90">
        📞 Llamar{farmacia.telefono ? ` (${farmacia.telefono})` : ''}
      </a>
    )}
    <div class="grid grid-cols-2 gap-2">
      {waHref && (
        <a href={waHref} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm font-medium hover:bg-[var(--color-bg-elev)]">
          💬 WhatsApp
        </a>
      )}
      <a href={mapsHref} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm font-medium hover:bg-[var(--color-bg-elev)]">
        📍 Cómo llegar
      </a>
    </div>
  </div>
</article>