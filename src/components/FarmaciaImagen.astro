---
interface Props {
  nombre: string;
  imagenUrl: string | null;
  class?: string;
}

const { nombre, imagenUrl } = Astro.props;

const iniciales = nombre
  .replace(/["',.]/g, '')
  .split(/\s+/)
  .filter((w) => w.length > 2 || /^[A-ZÁÉÍÓÚÑ]/.test(w))
  .slice(0, 2)
  .map((w) => w.charAt(0).toUpperCase())
  .join('');

const colores = [
  ['#16a34a', '#15803d'],
  ['#2563eb', '#1d4ed8'],
  ['#7c3aed', '#6d28d9'],
  ['#0891b2', '#0e7490'],
  ['#ca8a04', '#a16207'],
  ['#dc2626', '#b91c1c'],
  ['#0d9488', '#0f766e'],
  ['#4f46e5', '#4338ca'],
];
const colorIdx = nombre.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0) % colores.length;
const [from, to] = colores[colorIdx];
---

{
  imagenUrl ? (
    <img src={imagenUrl} alt={nombre} loading="lazy" class={Astro.props.class ?? 'w-full h-full object-cover'} />
  ) : (
    <svg viewBox="0 0 120 120" class={Astro.props.class ?? 'w-full h-full'} xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id={`grad-${colorIdx}`} x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color={from} />
          <stop offset="100%" stop-color={to} />
        </linearGradient>
      </defs>
      <rect width="120" height="120" rx="16" fill={`url(#grad-${colorIdx})`} />
      <text
        x="60" y="60"
        text-anchor="middle" dominant-baseline="central"
        fill="white" font-size="36" font-weight="700"
        font-family="system-ui, sans-serif"
      >{iniciales}</text>
    </svg>
  )
}
