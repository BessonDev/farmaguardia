# FarmaGuardia - Variables de entorno

# Contraseña del panel de administración (obligatoria, usar una segura en prod)
ADMIN_PASSWORD=changeme_segura

# URL pública del sitio (para SEO/OG, webhook del bot y enlaces)
SITE_URL=https://farmaguardia.tudominio.com

# Telegram Bot (opcional para reportes + bot consultable)
# Crea un bot con @BotFather y obtén el token
TELEGRAM_BOT_TOKEN=
# Chat ID donde recibir los reportes (puede ser tu propio chat o un grupo)
TELEGRAM_CHAT_ID=
# Secret para validar los updates del webhook (definir en prod)
TELEGRAM_WEBHOOK_SECRET=

# Secret HMAC para hashear IPs en reportes (usar un valor distinto en prod)
FINGERPRINT_SECRET=cambiar_este_secret

# Base de datos (opcional, por defecto farmaguardia.db en la raíz del proyecto)
# DB_PATH=/ruta/absoluta/farmaguardia.db
