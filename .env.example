# Password hasheado con argon2 (generar con: node -e "import('@node-rs/argon2').then(a=>a.hash('TU_PASSWORD',{memoryCost:19456,timeCost:2,outputLen:32,parallelism:1}).then(h=>console.log(h)))")
ADMIN_PASSWORD_HASH=

# Secret para firmar cookies de sesión (32+ caracteres random)
SESSION_SECRET=

# Path al archivo SQLite
DATABASE_URL=./data/farmaguardia.db

# Zona horaria del server (DEBE ser UTC para consistencia)
TZ=UTC

# Telegram bot (Fase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=